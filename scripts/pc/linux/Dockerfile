# Package versions (including transitive packages) come from packages.lock.json.
# Build context and packages.txt are generated by prepare-terminal.mjs.
FROM i386/alpine@sha256:b9932cfb425cd3dcccdc6c954227ffc6289693b1460dc10f7874299615bb6cda
ENV SOURCE_DATE_EPOCH=1794960000
COPY packages.txt /tmp/webpc-packages.txt
RUN xargs apk add --no-cache < /tmp/webpc-packages.txt && rm /tmp/webpc-packages.txt
RUN echo 'ttyS0::respawn:/sbin/agetty --autologin root -s ttyS0 115200 xterm-256color' >> /etc/inittab \
 && sed -i '/^root:/s|:[^:]*$|:/bin/bash|' /etc/passwd \
 && sed -i 's/^root:[^:]*:[^:]*:/root::0:/' /etc/shadow
RUN for service in devfs dmesg mdev; do rc-update add "$service" sysinit; done \
 && for service in hostname sysctl bootmisc; do rc-update add "$service" boot; done \
 && rc-update add killprocs shutdown
RUN mkinitfs -F 'base virtio 9p' $(cat /usr/share/kernel/virt/kernel.release)
RUN printf '\nWebPC Alpine Linux / offline browser VM\nBash, coreutils, Python, Node.js and nano are installed.\nSave session in the toolbar to keep your work.\n\n' > /etc/motd \
 && printf 'export TERM=xterm-256color\nexport PS1="webpc:\\w# "\nstty rows 24 cols 80\n' > /root/.bash_profile \
 && printf 'print("Hello from real Linux!")\n' > /root/hello.py \
 && printf 'console.log("Hello from real Linux!");\n' > /root/hello.js \
 && rm -f /var/log/apk.log
