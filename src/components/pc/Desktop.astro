---
import AppIcon from './AppIcon.astro';
import { apps, categories } from '../../scripts/pc/registry.mjs';
---
<div class="pc-shell" data-pc>
  <header class="pc-topbar">
    <a href="/" class="pc-home" aria-label="Back to Usman Shahid's site"><span aria-hidden="true">↖</span> usmanshahid<span class="pc-domain">.is-a.dev</span></a>
    <span class="pc-breadcrumb">/ <strong>WebPC</strong></span>
    <div class="pc-top-actions">
      <button type="button" data-open-app="about" class="pc-text-button">Help</button>
      <button type="button" data-theme-toggle class="pc-icon-button" aria-label="Switch color theme" title="Switch color theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button>
    </div>
  </header>
  <main class="pc-desktop" id="pc-workspace" aria-label="WebPC desktop">
    <div class="pc-wallpaper" aria-hidden="true">
      <svg class="pc-wallpaper-art" viewBox="0 0 1000 700" fill="none"><path d="M320 100 740 160 900 450 480 590 160 340Z"/><path d="M355 168 692 216 819 448 482 560 226 360Z"/><path d="M392 237 644 273 740 447 488 531 296 381Z"/><path d="M428 305 596 329 660 445 492 501 364 401Z"/><path d="m465 374 84 12 32 58-84 28-64-50Z"/></svg>
      <div class="pc-wallpaper-wordmark"><span>YOUR BROWSER WORKSPACE</span><strong>WebPC<span>.</span></strong><span>Make yourself at home.</span></div>
    </div>
    <h1 class="pc-sr-only">WebPC — your browser desktop</h1>
    <div class="pc-shortcuts" aria-label="Desktop apps">
      {apps.map(app => <button type="button" class="pc-shortcut" data-shortcut={app.id} aria-pressed="false" aria-describedby="pc-open-hint"><AppIcon id={app.id}/><span>{app.title}</span></button>)}
    </div>
    <p class="pc-desktop-hint" id="pc-open-hint"><span class="pc-mouse-hint">Double-click an app to open</span><span class="pc-touch-hint">Tap an app to open</span><span aria-hidden="true"> · </span><span>Enter works, too</span></p>
    <div class="pc-windows" data-windows></div>
  </main>
  <footer class="pc-taskbar" aria-label="Taskbar">
    <button type="button" class="pc-launcher-button" aria-controls="pc-launcher" aria-expanded="false" data-launcher-toggle><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h7v7H3zm11 0h7v7h-7zM3 14h7v7H3zm11 0h7v7h-7z" fill="currentColor"/></svg><span>Apps</span></button>
    <span class="pc-taskbar-divider" aria-hidden="true"></span>
    <div class="pc-tasks" data-tasks aria-label="Open windows"></div>
    <button type="button" class="pc-show-desktop" data-show-desktop title="Minimize all windows" aria-label="Show desktop"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg></button>
    <time class="pc-clock" data-clock aria-label="Local time"></time>
  </footer>
  <section id="pc-launcher" class="pc-launcher" aria-label="Apps" hidden>
    <div class="pc-launcher-heading"><strong>Your apps</strong><span>WebPC</span></div>
    <div class="pc-launcher-filters"><label for="pc-app-search" class="pc-sr-only">Search apps</label><input id="pc-app-search" type="search" placeholder="Search apps…" autocomplete="off" /><label for="pc-category" class="pc-sr-only">App category</label><select id="pc-category"><option value="all">All apps</option>{categories.map(category => <option value={category}>{category}</option>)}</select></div>
    <div class="pc-launcher-results" data-app-results>
    {apps.map(app => <button type="button" class="pc-launcher-app" data-open-app={app.id} data-app-result={app.id}><AppIcon id={app.id}/><span><strong>{app.title}</strong><small>{app.description}</small></span><span aria-hidden="true">↗</span></button>)}
    <p class="pc-launcher-empty" data-app-empty hidden>No apps found. Try another search.</p>
    </div>
    <div class="pc-launcher-footer"><span>Runs in your browser</span><a href="/">Back to site ↗</a></div>
  </section>
  <p class="pc-sr-only" data-announcement role="status" aria-live="polite"></p>
  <noscript><div class="pc-no-script">WebPC needs JavaScript to open its apps. <a href="/pc/apps/sheets/">Open Sheets directly</a> or <a href="/">return to the site</a>.</div></noscript>
</div>
<template id="pc-about-content">
  <div class="pc-about">
    <div class="pc-about-mark" aria-hidden="true">WebPC<span>.</span></div>
    <h2>A little desktop.<br/>Right in your browser.</h2>
    <p>Open an app and make something. Find your apps in the launcher, then arrange your workspace however you like.</p>
    <h3>Make yourself at home</h3>
    <dl><div><dt>Open an app</dt><dd>Double-click its desktop icon, press Enter, or use Apps. On touch screens, tap once.</dd></div><div><dt>Arrange your windows</dt><dd>Drag a title bar or its bottom-right corner. Focus a title bar and use arrow keys to move; Shift + arrows resizes. Double-click the title bar to maximize.</dd></div><div><dt>Pick up where you left off</dt><dd>Minimize keeps an app running. Its taskbar button brings it back.</dd></div></dl>
    <h3>Your work stays here</h3>
    <p>Apps that support local saving keep work in this browser on this device. Check each app’s help for its save and export options. Clearing site data or using a different browser won’t carry your work over. Export important work as a backup.</p>
    <a class="pc-about-link" href="/">Back to Usman’s site ↗</a>
  </div>
</template>
<script>import '../../scripts/pc/desktop.js';</script>
