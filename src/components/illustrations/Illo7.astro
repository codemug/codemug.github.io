<figure class="illo illo-7" role="group" aria-label="A producer and judge feedback loop stepped through to acceptance">
  <style is:global>
    .illo-7 {
      margin: 2.2em 0;
      padding: clamp(18px, 3vw, 26px);
      background: var(--color-panel);
      border: 1px solid var(--color-hairline);
      border-radius: 20px;
      font-family: var(--font-sans);
    }
    .illo-7 .hd {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-faint);
      margin: 0 0 16px;
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }
    .illo-7 .iter { color: var(--color-accent); font-variant-numeric: tabular-nums; }
    .illo-7 .scroll { overflow-x: auto; }
    .illo-7 svg { width: 100%; min-width: 520px; display: block; }
    .illo-7 .node rect { transition: stroke 0.3s, filter 0.3s; }
    .illo-7 .edge { transition: opacity 0.3s, stroke 0.3s; opacity: 0.4; }
    .illo-7 .edge.on { opacity: 1; }
    .illo-7 .edge.on path { stroke: var(--color-accent); }
    .illo-7 .edge.on text { fill: var(--color-accent); }
    .illo-7 .flow7 { stroke-dasharray: 7 9; animation: illo7flow 2.6s linear infinite; }
    .illo-7 .controls { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
    .illo-7 button {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1;
      padding: 9px 14px;
      border-radius: 8px;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text-muted);
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s, background 0.2s;
    }
    .illo-7 button:hover { border-color: var(--color-border-strong); color: var(--color-text); }
    .illo-7 button.primary {
      border-color: color-mix(in oklab, var(--color-accent) 50%, transparent);
      color: var(--color-accent);
      background: color-mix(in oklab, var(--color-accent) 8%, transparent);
    }
    .illo-7 .log {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--color-text-soft);
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid var(--color-hairline);
      min-height: 1.6em;
    }
    .illo-7 .log b { color: var(--color-accent); font-weight: 500; }
    .illo-7 figcaption {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.6;
      color: var(--color-text-dim);
      margin-top: 14px;
    }
    @keyframes illo7flow { to { stroke-dashoffset: -220; } }
    @media (prefers-reduced-motion: reduce) {
      .illo-7 .flow7 { animation: none; }
      .illo-7 .node rect, .illo-7 .edge { transition: none; }
    }
  </style>

  <p class="hd"><span>Directed cyclic graph · producer / judge</span><span class="iter">iteration 0 / 5 max</span></p>

  <div class="scroll">
    <svg viewBox="0 0 660 240" role="img" aria-label="Producer feeds a judge; the judge either rejects back to the producer or accepts and finishes">
      <defs>
        <linearGradient id="illo7-node" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color:var(--d-node)"></stop>
          <stop offset="1" style="stop-color:var(--d-node-2)"></stop>
        </linearGradient>
        <filter id="illo7-glow">
          <feGaussianBlur stdDeviation="3" result="b"></feGaussianBlur>
          <feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
        </filter>
      </defs>

      <g class="edge" data-edge="produce">
        <path d="M212 100 H286" fill="none" stroke="var(--color-text-dim)" stroke-width="1.4"></path>
        <path d="M282 96 l6 4 -6 4" fill="none" stroke="var(--color-text-dim)" stroke-width="1.4"></path>
        <text x="249" y="88" text-anchor="middle" fill="var(--color-text-dim)" font-size="10" font-family="JetBrains Mono">draft</text>
      </g>

      <g class="edge" data-edge="accept">
        <path d="M442 100 H516" fill="none" stroke="var(--color-text-dim)" stroke-width="1.4"></path>
        <path d="M512 96 l6 4 -6 4" fill="none" stroke="var(--color-text-dim)" stroke-width="1.4"></path>
        <text x="479" y="88" text-anchor="middle" fill="var(--color-text-dim)" font-size="10" font-family="JetBrains Mono">accept</text>
      </g>

      <g class="edge" data-edge="reject">
        <path d="M365 132 C365 200 137 200 137 132" fill="none" stroke="var(--color-text-dim)" stroke-width="1.4"></path>
        <path d="M133 138 l4 -6 4 6" fill="none" stroke="var(--color-text-dim)" stroke-width="1.4"></path>
        <text x="251" y="217" text-anchor="middle" fill="var(--color-text-dim)" font-size="10" font-family="JetBrains Mono">reject · with specific feedback</text>
      </g>

      <g class="node" data-node="producer">
        <rect x="62" y="68" width="150" height="64" rx="12" fill="url(#illo7-node)" stroke="var(--d-stroke)"></rect>
        <text x="137" y="96" text-anchor="middle" fill="var(--color-text)" font-size="14" font-weight="600">producer</text>
        <text x="137" y="114" text-anchor="middle" fill="var(--color-text-dim)" font-size="10.5" font-family="JetBrains Mono">only knows how to make</text>
      </g>

      <g class="node" data-node="judge">
        <rect x="290" y="68" width="152" height="64" rx="12" fill="url(#illo7-node)" stroke="var(--d-stroke)"></rect>
        <text x="366" y="96" text-anchor="middle" fill="var(--color-text)" font-size="14" font-weight="600">judge</text>
        <text x="366" y="114" text-anchor="middle" fill="var(--color-text-dim)" font-size="10.5" font-family="JetBrains Mono">only knows how to criticise</text>
      </g>

      <g class="node" data-node="done">
        <rect x="518" y="68" width="110" height="64" rx="12" fill="var(--d-fill-soft)" stroke="var(--d-teal)"></rect>
        <text x="573" y="105" text-anchor="middle" fill="var(--color-text)" font-size="14" font-weight="600">done</text>
      </g>
    </svg>
  </div>

  <div class="controls">
    <button type="button" class="primary" data-act="step">Step →</button>
    <button type="button" data-act="reset">Reset</button>
  </div>

  <p class="log">The loop supplies the quality no single pass had. Step through it.</p>

  <figcaption>Two narrow agents, one cycle, a hard cap. Reject sends it back with feedback; accept ends the run.</figcaption>

  <script is:inline>
    (() => {
      const root = document.currentScript.closest('.illo-7');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nodes = {};
      root.querySelectorAll('.node').forEach((n) => (nodes[n.dataset.node] = n));
      const edges = {};
      root.querySelectorAll('.edge').forEach((e) => (edges[e.dataset.edge] = e));
      const log = root.querySelector('.log');
      const iterEl = root.querySelector('.iter');

      const steps = [
        { node: 'producer', edge: null, iter: 0, txt: 'iter 0 · producer drafts from the brief' },
        { node: 'judge', edge: 'produce', iter: 0, txt: 'iter 0 · judge reviews → <b>reject</b>: "claims 2 and 4 unsupported"' },
        { node: 'producer', edge: 'reject', iter: 1, txt: 'iter 1 · producer revises against the feedback' },
        { node: 'judge', edge: 'produce', iter: 1, txt: 'iter 1 · judge reviews → <b>reject</b>: "claim 4 still unsupported"' },
        { node: 'producer', edge: 'reject', iter: 2, txt: 'iter 2 · producer revises again' },
        { node: 'judge', edge: 'produce', iter: 2, txt: 'iter 2 · judge reviews → <b>accept</b>' },
        { node: 'done', edge: 'accept', iter: 2, txt: 'accepted at iteration 2 of 5 — run complete' }
      ];
      let i = -1;

      const paint = () => {
        Object.values(nodes).forEach((n) => {
          const r = n.querySelector('rect');
          r.setAttribute('stroke', n.dataset.node === 'done' ? 'var(--d-teal)' : 'var(--d-stroke)');
          r.removeAttribute('filter');
        });
        Object.values(edges).forEach((e) => {
          e.classList.remove('on');
          e.querySelectorAll('path').forEach((p) => p.classList.remove('flow7'));
        });
        if (i < 0) {
          iterEl.textContent = 'iteration 0 / 5 max';
          log.innerHTML = 'The loop supplies the quality no single pass had. Step through it.';
          return;
        }
        const s = steps[i];
        const active = nodes[s.node].querySelector('rect');
        active.setAttribute('stroke', 'var(--color-accent)');
        active.setAttribute('filter', 'url(#illo7-glow)');
        if (s.edge) {
          edges[s.edge].classList.add('on');
          if (!reduce) edges[s.edge].querySelector('path').classList.add('flow7');
        }
        iterEl.textContent = 'iteration ' + s.iter + ' / 5 max';
        log.innerHTML = s.txt;
      };

      root.querySelector('[data-act="step"]').addEventListener('click', () => {
        i = i >= steps.length - 1 ? 0 : i + 1;
        paint();
      });
      root.querySelector('[data-act="reset"]').addEventListener('click', () => {
        i = -1;
        paint();
      });

      if (reduce) { i = steps.length - 1; }
      paint();
    })();
  </script>
</figure>
