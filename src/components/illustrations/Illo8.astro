<figure class="illo illo-8" role="group" aria-label="A run that parks while waiting, frees its worker, and resumes at the same point when a trigger fires">
  <style is:global>
    .illo-8 {
      margin: 2.2em 0;
      padding: clamp(18px, 3vw, 26px);
      background: var(--color-panel);
      border: 1px solid var(--color-hairline);
      border-radius: 20px;
      font-family: var(--font-sans);
    }
    .illo-8 .hd {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-faint);
      margin: 0 0 16px;
    }
    .illo-8 .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
    .illo-8 .chip8 {
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1;
      padding: 7px 10px;
      border-radius: 7px;
      border: 1px solid color-mix(in oklab, var(--color-accent) 40%, transparent);
      color: var(--color-accent);
      background: color-mix(in oklab, var(--color-accent) 7%, transparent);
      transition: color 0.3s, border-color 0.3s, background 0.3s, opacity 0.3s;
    }
    .illo-8 .chip8.free {
      border-style: dashed;
      border-color: var(--color-border);
      color: var(--color-text-faint);
      background: transparent;
    }
    .illo-8 .tl { display: flex; align-items: stretch; gap: 4px; height: 46px; }
    .illo-8 .ph {
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--color-text-dim);
      background: var(--color-surface-deep);
      border: 1px solid var(--color-border);
      text-align: center;
      padding: 0 6px;
      transition: border-color 0.3s, color 0.3s, background 0.3s;
      overflow: hidden;
    }
    .illo-8 .ph.gap { border-style: dashed; background: transparent; }
    .illo-8 .ph.mark {
      flex: 0 0 16px;
      padding: 0;
      background: var(--color-surface-2);
      border-color: var(--color-border-strong);
    }
    .illo-8 .ph.on {
      border-color: var(--color-accent);
      color: var(--color-accent);
      background: color-mix(in oklab, var(--color-accent) 9%, transparent);
    }
    .illo-8 .axis {
      display: flex;
      gap: 4px;
      margin-top: 8px;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--color-text-faint);
    }
    .illo-8 .axis span { text-align: center; overflow: hidden; white-space: nowrap; }
    .illo-8 .controls { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 18px; }
    .illo-8 button {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1;
      padding: 9px 14px;
      border-radius: 8px;
      border: 1px solid color-mix(in oklab, var(--color-accent) 50%, transparent);
      background: color-mix(in oklab, var(--color-accent) 8%, transparent);
      color: var(--color-accent);
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s, background 0.2s;
    }
    .illo-8 button:hover { border-color: var(--color-accent); }
    .illo-8 .log {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--color-text-soft);
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid var(--color-hairline);
      min-height: 1.6em;
    }
    .illo-8 .log b { color: var(--color-accent); font-weight: 500; }
    .illo-8 figcaption {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.6;
      color: var(--color-text-dim);
      margin-top: 14px;
    }
    @media (prefers-reduced-motion: reduce) {
      .illo-8 .ph, .illo-8 .chip8 { transition: none; }
    }
    @media (max-width: 480px) {
      .illo-8 .ph { font-size: 9.5px; }
      .illo-8 .axis { font-size: 9px; }
    }
  </style>

  <p class="hd">One run · event-driven execution</p>

  <div class="chips">
    <span class="chip8" data-chip="worker">worker attached</span>
    <span class="chip8" data-chip="conn">connection open</span>
  </div>

  <div class="tl">
    <div class="ph" data-i="0" style="flex:2">execute</div>
    <div class="ph mark" data-i="1" title="yielding tool call"></div>
    <div class="ph gap" data-i="2" style="flex:3.4">parked · nothing held open</div>
    <div class="ph mark" data-i="3" title="trigger fires"></div>
    <div class="ph" data-i="4" style="flex:2.2">resume → done</div>
  </div>

  <div class="axis">
    <span style="flex:2">t0</span>
    <span style="flex:0 0 16px"></span>
    <span style="flex:3.4">wait · minutes to days</span>
    <span style="flex:0 0 16px"></span>
    <span style="flex:2.2">09:00 trigger</span>
  </div>

  <div class="controls">
    <button type="button" data-act="play">Play the run</button>
  </div>

  <p class="log">The run executes, hits a wait, parks, and resumes at the exact same point.</p>

  <figcaption>While parked there is no worker and no open connection — only saved state waiting for an event.</figcaption>

  <script is:inline>
    (() => {
      const root = document.currentScript.closest('.illo-8');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const phases = [...root.querySelectorAll('.ph')];
      const worker = root.querySelector('[data-chip="worker"]');
      const conn = root.querySelector('[data-chip="conn"]');
      const log = root.querySelector('.log');
      const btn = root.querySelector('[data-act="play"]');

      const steps = [
        { i: 0, free: false, txt: 'executing · the agent works on a worker' },
        { i: 1, free: false, txt: 'a yielding tool call — the run has to <b>wait</b>' },
        { i: 2, free: true, txt: '<b>parked</b> · state saved, worker released, no connection held' },
        { i: 3, free: true, txt: 'trigger fires at <b>09:00</b> — the run becomes resumable' },
        { i: 4, free: false, txt: '<b>resumed</b> at the exact same point · continues to done' }
      ];
      let timer = null;

      const paint = (n) => {
        const s = steps[n];
        phases.forEach((p, k) => p.classList.toggle('on', k <= s.i));
        worker.classList.toggle('free', s.free);
        worker.textContent = s.free ? 'worker released' : 'worker attached';
        conn.classList.toggle('free', s.free);
        conn.textContent = s.free ? 'no connection held' : 'connection open';
        log.innerHTML = s.txt;
      };

      const play = () => {
        clearInterval(timer);
        let n = 0;
        paint(0);
        timer = setInterval(() => {
          n++;
          if (n >= steps.length) { clearInterval(timer); return; }
          paint(n);
        }, 1400);
      };

      let manual = 0;
      btn.addEventListener('click', () => {
        if (reduce) {
          manual = (manual + 1) % steps.length;
          paint(manual);
        } else play();
      });
      if (reduce) { btn.textContent = 'Advance the run'; manual = steps.length - 1; paint(manual); }
      else paint(0);
    })();
  </script>
</figure>
