<figure class="illo illo-9" role="group" aria-label="An approval gate where safe tool calls pass through and risky ones park for a human decision">
  <style is:global>
    .illo-9 {
      margin: 2.2em 0;
      padding: clamp(18px, 3vw, 26px);
      background: var(--color-panel);
      border: 1px solid var(--color-hairline);
      border-radius: 20px;
      font-family: var(--font-sans);
    }
    .illo-9 .hd {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-faint);
      margin: 0 0 16px;
    }
    .illo-9 .scroll { overflow-x: auto; }
    .illo-9 svg.main { width: 100%; min-width: 560px; display: block; }
    .illo-9 .inset {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid var(--color-hairline);
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .illo-9 .box9 {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--color-text-muted);
      background: var(--color-surface-deep);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 8px 11px;
      line-height: 1;
    }
    .illo-9 .box9.accent {
      color: var(--color-accent);
      border-color: color-mix(in oklab, var(--color-accent) 45%, transparent);
      background: color-mix(in oklab, var(--color-accent) 7%, transparent);
    }
    .illo-9 .box9.dim { color: var(--color-text-faint); }
    .illo-9 .arr9 { font-family: var(--font-mono); font-size: 11px; color: var(--color-text-faint); }
    .illo-9 figcaption {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.6;
      color: var(--color-text-dim);
      margin-top: 16px;
    }
    .illo-9 .flow9 { stroke-dasharray: 7 9; animation: illo9flow 2.6s linear infinite; }
    @keyframes illo9flow { to { stroke-dashoffset: -220; } }
    @media (prefers-reduced-motion: reduce) { .illo-9 .flow9 { animation: none; } }
  </style>

  <p class="hd">Approval policy · the gate before the call</p>

  <div class="scroll">
    <svg class="main" viewBox="0 0 660 250" role="img" aria-label="Safe tool calls pass the gate straight to execute; risky calls park for a human approve or deny">
      <defs>
        <linearGradient id="illo9-node" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color:var(--d-node)"></stop>
          <stop offset="1" style="stop-color:var(--d-node-2)"></stop>
        </linearGradient>
      </defs>

      <rect x="250" y="20" width="94" height="210" rx="14" fill="var(--d-fill-soft)" stroke="var(--color-accent)" stroke-dasharray="6 6" opacity=".9"></rect>
      <text x="297" y="42" text-anchor="middle" fill="var(--color-accent)" font-size="12" font-weight="600" font-family="JetBrains Mono">GATE</text>
      <text x="297" y="216" text-anchor="middle" fill="var(--color-text-dim)" font-size="9.5" font-family="JetBrains Mono">required · policy · llm</text>

      <path d="M150 78 H250" fill="none" stroke="var(--color-accent)" stroke-width="1.4" class="flow9"></path>
      <path d="M344 78 H416" fill="none" stroke="var(--color-accent)" stroke-width="1.4" class="flow9"></path>
      <text x="200" y="68" text-anchor="middle" fill="var(--color-text-dim)" font-size="9.5" font-family="JetBrains Mono">passes</text>

      <path d="M150 172 H248" fill="none" stroke="var(--color-text-dim)" stroke-width="1.4" stroke-dasharray="4 6"></path>
      <text x="199" y="162" text-anchor="middle" fill="var(--color-text-dim)" font-size="9.5" font-family="JetBrains Mono">parks</text>
      <path d="M344 172 H416" fill="none" stroke="var(--color-text-dim)" stroke-width="1.4" stroke-dasharray="4 6"></path>

      <path d="M540 148 V106" fill="none" stroke="var(--color-accent)" stroke-width="1.4"></path>
      <path d="M536 110 l4 -6 4 6" fill="none" stroke="var(--color-accent)" stroke-width="1.4"></path>
      <text x="552" y="130" fill="var(--color-accent)" font-size="9.5" font-family="JetBrains Mono">approve</text>
      <path d="M470 196 V222" fill="none" stroke="var(--color-text-dim)" stroke-width="1.4"></path>
      <text x="482" y="226" fill="var(--color-text-dim)" font-size="9.5" font-family="JetBrains Mono">deny → denial recorded</text>

      <g>
        <rect x="20" y="54" width="130" height="48" rx="11" fill="url(#illo9-node)" stroke="var(--d-stroke)"></rect>
        <text x="85" y="75" text-anchor="middle" fill="var(--color-text)" font-size="12.5" font-weight="600">safe call</text>
        <text x="85" y="91" text-anchor="middle" fill="var(--color-text-dim)" font-size="10" font-family="JetBrains Mono">metrics_query</text>
      </g>
      <g>
        <rect x="20" y="148" width="130" height="48" rx="11" fill="url(#illo9-node)" stroke="var(--d-stroke)"></rect>
        <text x="85" y="169" text-anchor="middle" fill="var(--color-text)" font-size="12.5" font-weight="600">risky call</text>
        <text x="85" y="185" text-anchor="middle" fill="var(--color-text-dim)" font-size="10" font-family="JetBrains Mono">k8s_delete</text>
      </g>
      <g>
        <rect x="416" y="54" width="220" height="48" rx="11" fill="url(#illo9-node)" stroke="var(--color-accent)"></rect>
        <text x="526" y="83" text-anchor="middle" fill="var(--color-accent)" font-size="13.5" font-weight="600">execute</text>
      </g>
      <g>
        <rect x="416" y="148" width="220" height="48" rx="11" fill="var(--d-fill-soft)" stroke="var(--d-teal)"></rect>
        <text x="526" y="169" text-anchor="middle" fill="var(--color-text)" font-size="12.5" font-weight="600">human decides</text>
        <text x="526" y="185" text-anchor="middle" fill="var(--color-text-dim)" font-size="10" font-family="JetBrains Mono">same park &amp; resume machinery</text>
      </g>
    </svg>
  </div>

  <div class="inset">
    <span class="box9">agent</span>
    <span class="arr9" aria-hidden="true">→</span>
    <span class="box9 accent">web</span>
    <span class="arr9" aria-hidden="true">→</span>
    <span class="box9 accent">tavily</span>
    <span class="arr9" aria-hidden="true">→</span>
    <span class="box9 dim">exa</span>
    <span class="arr9" aria-hidden="true">→</span>
    <span class="box9 dim">duckduckgo</span>
  </div>

  <figcaption>One clean web tool with a provider fallback behind it. One gate in front of anything destructive.</figcaption>
</figure>
