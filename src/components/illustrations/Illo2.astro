<figure class="illo illo-2" role="group" aria-label="How added context dilutes the attention paid to the tokens that matter">
  <style is:global>
    .illo-2 {
      margin: 2.2em 0;
      padding: clamp(18px, 3vw, 26px);
      background: var(--color-panel);
      border: 1px solid var(--color-hairline);
      border-radius: 20px;
      font-family: var(--font-sans);
    }
    .illo-2 .hd {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-faint);
      margin: 0 0 16px;
    }
    .illo-2 .ctl {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }
    .illo-2 .ctl label {
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--color-text-dim);
      white-space: nowrap;
    }
    .illo-2 input[type="range"] {
      flex: 1 1 200px;
      min-width: 150px;
      accent-color: var(--color-accent);
      height: 22px;
      cursor: pointer;
    }
    .illo-2 .ctxval {
      font-family: var(--font-mono);
      font-size: 12.5px;
      color: var(--color-accent);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .illo-2 .field {
      display: grid;
      grid-template-columns: repeat(24, 1fr);
      gap: 3px;
      padding: 14px;
      border-radius: 12px;
      background: var(--color-surface-deep);
      border: 1px solid var(--color-hairline);
    }
    .illo-2 .field i {
      display: block;
      aspect-ratio: 1;
      border-radius: 2px;
      background: var(--color-text-faint);
      opacity: 0.16;
      transition: opacity 0.35s ease, transform 0.35s ease;
    }
    .illo-2 .field i.off { opacity: 0; transform: scale(0.4); }
    .illo-2 .field i.rel {
      background: var(--color-accent);
      border-radius: 3px;
      opacity: 1;
    }
    .illo-2 .legend {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--color-text-dim);
      margin-top: 12px;
    }
    .illo-2 .legend span { display: inline-flex; align-items: center; gap: 7px; }
    .illo-2 .swatch { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
    .illo-2 .meterwrap { margin-top: 20px; }
    .illo-2 .meterrow {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--color-text-dim);
      margin-bottom: 8px;
    }
    .illo-2 .meterrow b {
      color: var(--color-accent);
      font-size: 16px;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }
    .illo-2 .meter {
      height: 8px;
      border-radius: 5px;
      background: var(--color-surface-2);
      overflow: hidden;
    }
    .illo-2 .meter div {
      height: 100%;
      width: 62%;
      border-radius: 5px;
      background: var(--color-accent);
      transition: width 0.35s ease;
    }
    .illo-2 .mech {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--color-text-soft);
      margin-top: 16px;
      font-variant-numeric: tabular-nums;
    }
    .illo-2 .panel2 {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid var(--color-hairline);
    }
    .illo-2 .seg { display: flex; gap: 6px; flex-wrap: wrap; margin: 14px 0 16px; }
    .illo-2 .seg button {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1;
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text-muted);
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s, background 0.2s;
    }
    .illo-2 .seg button:hover { border-color: var(--color-border-strong); color: var(--color-text); }
    .illo-2 .seg button[aria-pressed="true"] {
      border-color: var(--color-accent);
      color: var(--color-accent);
      background: color-mix(in oklab, var(--color-accent) 8%, transparent);
    }
    .illo-2 .ctxbar {
      position: relative;
      height: 34px;
      border-radius: 8px;
      background: var(--color-surface-deep);
      border: 1px solid var(--color-border);
      overflow: hidden;
    }
    .illo-2 .ctxbar::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        transparent,
        color-mix(in oklab, var(--color-text-faint) 22%, transparent) 50%,
        transparent
      );
    }
    .illo-2 .fact {
      position: absolute;
      top: 5px;
      bottom: 5px;
      width: 10px;
      border-radius: 3px;
      background: var(--color-accent);
      z-index: 2;
      transition: left 0.4s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.4s;
    }
    .illo-2 .found {
      font-family: var(--font-mono);
      font-size: 12px;
      margin-top: 12px;
      color: var(--color-text-dim);
    }
    .illo-2 .found b { color: var(--color-accent); font-weight: 500; }
    .illo-2 figcaption {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.6;
      color: var(--color-text-dim);
      margin-top: 18px;
    }
    @media (prefers-reduced-motion: reduce) {
      .illo-2 .field i,
      .illo-2 .meter div,
      .illo-2 .fact { transition: none; }
    }
    @media (max-width: 520px) {
      .illo-2 .field { grid-template-columns: repeat(16, 1fr); }
    }
  </style>

  <p class="hd">Attention dilution · one budget, split every way</p>

  <div class="ctl">
    <label for="illo2-range">context size</label>
    <input id="illo2-range" type="range" min="0" max="100" value="30" aria-label="Total context size in tokens" />
    <span class="ctxval">1,000 tokens</span>
  </div>

  <div class="field" aria-hidden="true"></div>

  <div class="legend">
    <span><i class="swatch" style="background:var(--color-accent)"></i>5 tokens that matter</span>
    <span><i class="swatch" style="background:var(--color-text-faint);opacity:.5"></i>everything else in the prompt</span>
  </div>

  <div class="meterwrap">
    <div class="meterrow"><span>signal on the tokens that matter</span><b>62%</b></div>
    <div class="meter"><div></div></div>
  </div>

  <p class="mech">1.0 unit of attention ÷ 1,000 tokens = 0.0010 per token</p>

  <div class="panel2">
    <p class="hd" style="margin-bottom:0">Lost in the middle</p>
    <div class="seg" role="group" aria-label="Where the fact sits in the context">
      <button type="button" data-pos="start" aria-pressed="false">at the start</button>
      <button type="button" data-pos="mid" aria-pressed="true">in the middle</button>
      <button type="button" data-pos="end" aria-pressed="false">at the end</button>
    </div>
    <div class="ctxbar"><span class="fact" style="left:calc(50% - 5px)"></span></div>
    <p class="found">retrieval: <b>missed</b> — the same fact, buried mid-context</p>
  </div>

  <figcaption>Same five relevant tokens throughout. Every token you add spends from the same fixed budget, so the signal thins out.</figcaption>

  <script is:inline>
    (() => {
      const root = document.currentScript.closest('.illo-2');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const field = root.querySelector('.field');
      const TOTAL = 240;
      const REL = [27, 63, 108, 151, 196];
      const cells = [];
      for (let i = 0; i < TOTAL; i++) {
        const c = document.createElement('i');
        if (REL.includes(i)) c.classList.add('rel');
        field.appendChild(c);
        cells.push(c);
      }

      const range = root.querySelector('#illo2-range');
      const ctxval = root.querySelector('.ctxval');
      const meter = root.querySelector('.meter div');
      const pctEl = root.querySelector('.meterrow b');
      const mech = root.querySelector('.mech');
      const fmt = (n) => Math.round(n).toLocaleString('en-US');

      const render = () => {
        const f = range.value / 100;
        const N = 200 * Math.pow(250, f);
        const signal = 90 - 75 * f;
        const shown = Math.round(16 + (TOTAL - 16) * Math.pow(f, 0.75));
        cells.forEach((c, i) => {
          const rel = c.classList.contains('rel');
          if (rel) {
            c.classList.remove('off');
            const s = signal / 90;
            c.style.opacity = String(0.3 + 0.7 * s);
            c.style.transform = 'scale(' + (0.72 + 0.28 * s) + ')';
            c.style.boxShadow = reduce
              ? 'none'
              : '0 0 ' + (9 * s).toFixed(1) + 'px color-mix(in oklab, var(--color-accent) ' + Math.round(70 * s) + '%, transparent)';
          } else {
            c.classList.toggle('off', i >= shown);
          }
        });
        ctxval.textContent = fmt(N) + ' tokens';
        meter.style.width = signal.toFixed(0) + '%';
        pctEl.textContent = signal.toFixed(0) + '%';
        mech.textContent =
          '1.0 unit of attention ÷ ' + fmt(N) + ' tokens = ' + (1 / N).toFixed(5) + ' per token';
      };
      range.addEventListener('input', render);
      render();

      const fact = root.querySelector('.fact');
      const found = root.querySelector('.found');
      const states = {
        start: { left: '6px', txt: 'retrieval: <b>found</b> — early tokens keep a clean share' },
        mid: { left: 'calc(50% - 5px)', txt: 'retrieval: <b>missed</b> — the same fact, buried mid-context' },
        end: { left: 'calc(100% - 16px)', txt: 'retrieval: <b>found</b> — recent tokens stay sharp' }
      };
      root.querySelectorAll('.seg button').forEach((b) => {
        b.addEventListener('click', () => {
          const s = states[b.dataset.pos];
          fact.style.left = s.left;
          fact.style.opacity = b.dataset.pos === 'mid' ? '0.35' : '1';
          found.innerHTML = s.txt;
          root.querySelectorAll('.seg button').forEach((o) =>
            o.setAttribute('aria-pressed', String(o === b))
          );
        });
      });
      fact.style.opacity = '0.35';
    })();
  </script>
</figure>
