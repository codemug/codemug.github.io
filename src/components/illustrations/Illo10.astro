<figure class="illo illo-10" role="group" aria-label="A git-backed harness bundle installed into Primer as live agents and a graph">
  <style is:global>
    .illo-10 {
      margin: 2.2em 0;
      padding: clamp(18px, 3vw, 26px);
      background: var(--color-panel);
      border: 1px solid var(--color-hairline);
      border-radius: 20px;
      font-family: var(--font-sans);
    }
    .illo-10 .hd {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-faint);
      margin: 0 0 16px;
    }
    .illo-10 .row {
      display: grid;
      grid-template-columns: 1fr 92px 1.15fr;
      align-items: center;
      gap: 6px;
    }
    .illo-10 .card {
      background: var(--color-surface-deep);
      border: 1px solid var(--color-border);
      border-radius: 14px;
      padding: 14px;
    }
    .illo-10 .card.live { border-color: color-mix(in oklab, var(--color-accent) 45%, transparent); }
    .illo-10 .ct {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      color: var(--color-text-dim);
      margin: 0 0 10px;
      display: flex;
      align-items: center;
      gap: 7px;
    }
    .illo-10 .card.live .ct { color: var(--color-accent); }
    .illo-10 pre {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--color-text-muted);
      line-height: 1.85;
      margin: 0;
      padding: 10px 11px;
      background: var(--color-surface-2);
      border: 1px solid var(--color-hairline);
      border-radius: 8px;
      white-space: pre;
      overflow-x: auto;
    }
    .illo-10 pre b { color: var(--color-text); font-weight: 500; }
    .illo-10 .conn { text-align: center; }
    .illo-10 .conn .cap {
      display: block;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--color-text-dim);
      margin-top: 6px;
    }
    .illo-10 .conn .cap.back { color: var(--color-text-faint); margin-top: 12px; }
    .illo-10 .mats { display: flex; flex-wrap: wrap; gap: 6px; }
    .illo-10 .mat {
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--color-text-soft);
      background: var(--color-surface-2);
      border: 1px solid var(--color-hairline);
      border-radius: 6px;
      padding: 6px 8px;
      line-height: 1;
    }
    .illo-10 .badge {
      display: inline-block;
      margin-left: 6px;
      font-size: 9.5px;
      color: var(--color-accent);
      border: 1px solid color-mix(in oklab, var(--color-accent) 35%, transparent);
      border-radius: 4px;
      padding: 2px 4px;
    }
    .illo-10 .graph { margin-top: 10px; }
    .illo-10 .graph svg { width: 100%; max-width: 260px; display: block; }
    .illo-10 figcaption {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.6;
      color: var(--color-text-dim);
      margin-top: 16px;
    }
    @media (max-width: 620px) {
      .illo-10 .row { grid-template-columns: 1fr; }
      .illo-10 .conn svg { transform: rotate(90deg); }
      .illo-10 .conn { padding: 10px 0; }
    }
  </style>

  <p class="hd">Harness · a tuned setup, packaged</p>

  <div class="row">
    <div class="card">
      <p class="ct">
        <svg width="13" height="13" viewBox="0 0 13 13" aria-hidden="true">
          <circle cx="6.5" cy="6.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.1"></circle>
          <circle cx="6.5" cy="6.5" r="1.7" fill="currentColor"></circle>
        </svg>
        git · ops-triage-harness
      </p>
      <pre>harness.yaml
templates/
  ├─ <b>agents/</b>
  ├─ <b>graphs/</b>
  ├─ tools/
  └─ collections/</pre>
    </div>

    <div class="conn">
      <svg width="80" height="12" viewBox="0 0 80 12" aria-hidden="true">
        <path d="M0 6h70M66 2l4 4-4 4" fill="none" stroke="var(--color-accent)" stroke-width="1.3"></path>
      </svg>
      <span class="cap">install · one step</span>
      <svg width="80" height="12" viewBox="0 0 80 12" style="margin-top:14px" aria-hidden="true">
        <path d="M80 6H10M14 2l-4 4 4 4" fill="none" stroke="var(--color-text-faint)" stroke-width="1.1" stroke-dasharray="4 5"></path>
      </svg>
      <span class="cap back">publish</span>
    </div>

    <div class="card live">
      <p class="ct">primer</p>
      <div class="mats">
        <span class="mat">triage-agent<span class="badge">harness_id</span></span>
        <span class="mat">runbook-agent<span class="badge">harness_id</span></span>
        <span class="mat">escalate-tool<span class="badge">harness_id</span></span>
      </div>
      <div class="graph">
        <svg viewBox="0 0 260 56" role="img" aria-label="Installed graph: triage feeds runbook, which feeds escalate">
          <path d="M74 28h20M168 28h20" fill="none" stroke="var(--color-accent)" stroke-width="1.2" opacity=".8"></path>
          <rect x="2" y="10" width="72" height="36" rx="9" fill="var(--d-node)" stroke="var(--d-stroke)"></rect>
          <text x="38" y="32" text-anchor="middle" fill="var(--color-text)" font-size="10.5" font-family="JetBrains Mono">triage</text>
          <rect x="94" y="10" width="74" height="36" rx="9" fill="var(--d-node)" stroke="var(--d-stroke)"></rect>
          <text x="131" y="32" text-anchor="middle" fill="var(--color-text)" font-size="10.5" font-family="JetBrains Mono">runbook</text>
          <rect x="188" y="10" width="70" height="36" rx="9" fill="var(--d-fill-soft)" stroke="var(--d-teal)"></rect>
          <text x="223" y="32" text-anchor="middle" fill="var(--color-text)" font-size="10.5" font-family="JetBrains Mono">escalate</text>
        </svg>
      </div>
    </div>
  </div>

  <figcaption>Helm for Primer: install a tuned setup in one step — someone else's context tuning, already converged.</figcaption>
</figure>
