<figure class="illo illo-1" role="group" aria-label="The 16GB VRAM ceiling and how quantization fits a 12B model inside it">
  <style is:global>
    .illo-1 {
      margin: 2.2em 0;
      padding: clamp(18px, 3vw, 26px);
      background: var(--color-panel);
      border: 1px solid var(--color-hairline);
      border-radius: 20px;
      font-family: var(--font-sans);
    }
    .illo-1 .hd {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-faint);
      margin: 0 0 16px;
    }
    .illo-1 .seg {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 20px;
    }
    .illo-1 .seg button {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1;
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text-muted);
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s, background 0.2s;
    }
    .illo-1 .seg button:hover {
      border-color: var(--color-border-strong);
      color: var(--color-text);
    }
    .illo-1 .seg button[aria-pressed="true"] {
      border-color: var(--color-accent);
      color: var(--color-accent);
      background: color-mix(in oklab, var(--color-accent) 8%, transparent);
    }
    .illo-1 .track {
      position: relative;
      height: 56px;
      border-radius: 10px;
      background: var(--color-surface-deep);
      border: 1px solid var(--color-border);
    }
    .illo-1 .seglayer {
      position: absolute;
      top: 5px;
      bottom: 5px;
      border-radius: 7px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      transition: width 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
        left 0.55s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.35s;
    }
    .illo-1 .weights {
      left: 5px;
      background: color-mix(in oklab, var(--color-accent) 16%, transparent);
      border: 1px solid color-mix(in oklab, var(--color-accent) 55%, transparent);
    }
    .illo-1 .headroom {
      border: 1px dashed var(--color-border-strong);
      background: transparent;
    }
    .illo-1 .over {
      border: 1px solid var(--color-border-strong);
      background: repeating-linear-gradient(
        135deg,
        color-mix(in oklab, var(--color-text-dim) 26%, transparent) 0 2px,
        transparent 2px 7px
      );
    }
    .illo-1 .lab {
      font-family: var(--font-mono);
      font-size: 11px;
      white-space: nowrap;
      padding: 0 8px;
    }
    .illo-1 .weights .lab { color: var(--color-accent); }
    .illo-1 .headroom .lab { color: var(--color-text-dim); }
    .illo-1 .over .lab { color: var(--color-text-dim); }
    .illo-1 .ceiling {
      position: absolute;
      top: -9px;
      bottom: -9px;
      width: 0;
      border-left: 1px dashed var(--color-accent);
      opacity: 0.75;
    }
    .illo-1 .ceilinglab {
      position: absolute;
      top: -26px;
      transform: translateX(-50%);
      font-family: var(--font-mono);
      font-size: 10.5px;
      letter-spacing: 0.06em;
      color: var(--color-accent);
      white-space: nowrap;
    }
    .illo-1 .scale {
      display: flex;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--color-text-faint);
      margin-top: 8px;
    }
    .illo-1 .readout {
      font-family: var(--font-mono);
      font-size: 12.5px;
      color: var(--color-text-soft);
      margin-top: 18px;
      font-variant-numeric: tabular-nums;
    }
    .illo-1 .readout b { color: var(--color-accent); font-weight: 500; }
    .illo-1 figcaption {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.6;
      color: var(--color-text-dim);
      margin-top: 16px;
    }
    .illo-1 .wrap { padding-top: 30px; }
    @media (prefers-reduced-motion: reduce) {
      .illo-1 .seglayer { transition: none; }
    }
    @media (max-width: 420px) {
      .illo-1 .lab { font-size: 10px; padding: 0 4px; }
    }
  </style>

  <p class="hd">16 GB VRAM budget · 12B model</p>

  <div class="seg" role="group" aria-label="Weight precision">
    <button type="button" data-p="fp16" aria-pressed="false">FP16</button>
    <button type="button" data-p="q8" aria-pressed="false">8-bit</button>
    <button type="button" data-p="q4" aria-pressed="true">4-bit · Q4_K_M</button>
  </div>

  <div class="wrap">
    <div class="track">
      <div class="seglayer weights" style="width:23%"><span class="lab">weights 6 GB</span></div>
      <div class="seglayer headroom" style="left:25%;width:41%"><span class="lab">headroom for context</span></div>
      <div class="seglayer over" style="left:66.7%;width:0;opacity:0"><span class="lab">over budget</span></div>
      <div class="ceiling" style="left:66.7%"></div>
      <div class="ceilinglab" style="left:66.7%">16 GB ceiling</div>
    </div>
    <div class="scale"><span>0 GB</span><span>24 GB</span></div>
  </div>

  <p class="readout">weights: <b>6 GB</b> · context headroom: <b>10 GB</b></p>

  <figcaption>Quantization is the lever that makes it fit at all — the same 12B weights, three precisions, one hard ceiling.</figcaption>

  <script is:inline>
    (() => {
      const root = document.currentScript.closest('.illo-1');
      const MAX = 24, CEIL = 16;
      const modes = {
        fp16: { gb: 24, label: 'FP16' },
        q8: { gb: 12, label: '8-bit' },
        q4: { gb: 6, label: '4-bit' }
      };
      const w = root.querySelector('.weights');
      const h = root.querySelector('.headroom');
      const o = root.querySelector('.over');
      const out = root.querySelector('.readout');
      const pct = (gb) => (gb / MAX) * 100;

      const set = (key) => {
        const m = modes[key];
        const fit = Math.min(m.gb, CEIL);
        w.style.width = 'calc(' + pct(fit) + '% - 10px)';
        w.querySelector('.lab').textContent = 'weights ' + m.gb + ' GB';
        const head = Math.max(0, CEIL - m.gb);
        h.style.left = pct(fit) + '%';
        h.style.width = 'calc(' + pct(head) + '% - 4px)';
        h.style.opacity = head > 1 ? '1' : '0';
        const over = Math.max(0, m.gb - CEIL);
        o.style.left = pct(CEIL) + '%';
        o.style.width = 'calc(' + pct(over) + '% - 6px)';
        o.style.opacity = over > 0 ? '1' : '0';
        out.innerHTML = over > 0
          ? 'weights: <b>' + m.gb + ' GB</b> · over budget by <b>' + over + ' GB</b> — will not load'
          : 'weights: <b>' + m.gb + ' GB</b> · context headroom: <b>' + head + ' GB</b>';
        root.querySelectorAll('.seg button').forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.p === key))
        );
      };

      root.querySelectorAll('.seg button').forEach((b) =>
        b.addEventListener('click', () => set(b.dataset.p))
      );
      set('q4');
    })();
  </script>
</figure>
