<figure class="illo illo-6" role="group" aria-label="A producer agent and a reviewer agent sharing one workspace folder">
  <style is:global>
    .illo-6 {
      margin: 2.2em 0;
      padding: clamp(18px, 3vw, 26px);
      background: var(--color-panel);
      border: 1px solid var(--color-hairline);
      border-radius: 20px;
      font-family: var(--font-sans);
    }
    .illo-6 .hd {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-faint);
      margin: 0 0 16px;
    }
    .illo-6 .row {
      display: grid;
      grid-template-columns: 1fr 46px 1.5fr 46px 1fr;
      align-items: center;
      gap: 4px;
    }
    .illo-6 .agent {
      background: var(--color-surface-deep);
      border: 1px solid var(--color-border);
      border-radius: 12px;
      padding: 13px 12px;
      text-align: center;
    }
    .illo-6 .agent .n {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--color-text);
      display: block;
    }
    .illo-6 .agent .d {
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--color-text-dim);
      display: block;
      margin-top: 5px;
    }
    .illo-6 .conn { text-align: center; }
    .illo-6 .conn .cap {
      display: block;
      font-family: var(--font-mono);
      font-size: 9.5px;
      color: var(--color-text-dim);
      margin-top: 6px;
      line-height: 1.3;
    }
    .illo-6 .ws {
      background: var(--color-surface-deep);
      border: 1px solid color-mix(in oklab, var(--color-accent) 40%, transparent);
      border-radius: 14px;
      padding: 14px;
    }
    .illo-6 .ws .title {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--color-accent);
      letter-spacing: 0.06em;
      margin: 0 0 10px;
    }
    .illo-6 .tree {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--color-text-muted);
      line-height: 1.85;
      margin: 0;
      padding: 10px 11px;
      background: var(--color-surface-2);
      border: 1px solid var(--color-hairline);
      border-radius: 8px;
      white-space: pre;
      overflow-x: auto;
    }
    .illo-6 .tree b { color: var(--color-text); font-weight: 500; }
    .illo-6 .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .illo-6 .chip6 {
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--color-text-dim);
      background: var(--color-surface-2);
      border: 1px solid var(--color-hairline);
      border-radius: 6px;
      padding: 5px 8px;
      line-height: 1;
    }
    .illo-6 .rule {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--color-text-soft);
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid var(--color-hairline);
    }
    .illo-6 figcaption {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.6;
      color: var(--color-text-dim);
      margin-top: 14px;
    }
    @media (max-width: 620px) {
      .illo-6 .row { grid-template-columns: 1fr; }
      .illo-6 .conn svg { transform: rotate(90deg); }
      .illo-6 .conn { padding: 8px 0; }
    }
  </style>

  <p class="hd">Workspace · a shared folder and a place to run commands</p>

  <div class="row">
    <div class="agent">
      <span class="n">producer</span>
      <span class="d">writes the file</span>
    </div>

    <div class="conn">
      <svg width="40" height="12" viewBox="0 0 40 12" aria-hidden="true">
        <path d="M0 6h32M28 2l4 4-4 4" fill="none" stroke="var(--color-accent)" stroke-width="1.2"></path>
      </svg>
      <span class="cap">write</span>
    </div>

    <div class="ws">
      <p class="title">/workspace</p>
      <pre class="tree">reports/
  └─ <b>analysis.json</b>
notes.md
TASKS.md</pre>
      <div class="chips">
        <span class="chip6">exec · shell</span>
        <span class="chip6">read · write · list</span>
      </div>
    </div>

    <div class="conn">
      <svg width="40" height="12" viewBox="0 0 40 12" aria-hidden="true">
        <path d="M0 6h32M28 2l4 4-4 4" fill="none" stroke="var(--color-accent)" stroke-width="1.2"></path>
      </svg>
      <span class="cap">read</span>
    </div>

    <div class="agent">
      <span class="n">reviewer</span>
      <span class="d">reads the same file</span>
    </div>
  </div>

  <p class="rule">
    <svg width="13" height="15" viewBox="0 0 13 15" aria-hidden="true">
      <rect x="1" y="6" width="11" height="8" rx="2" fill="none" stroke="var(--color-accent)" stroke-width="1.2"></rect>
      <path d="M3.5 6V4a3 3 0 0 1 6 0v2" fill="none" stroke="var(--color-accent)" stroke-width="1.2"></path>
    </svg>
    read-before-write · no agent quietly overwrites another's work
  </p>

  <figcaption>The file is the whole interface between them. A task list is just a file with checkboxes.</figcaption>
</figure>
