  .pr5[data-frame="3"] .cat.hl{color:var(--color-accent);border-color:color-mix(in oklab,var(--color-accent) 45%,transparent);background:color-mix(in oklab,var(--color-accent) 10%,transparent)}

  /* pr6 workspace */
