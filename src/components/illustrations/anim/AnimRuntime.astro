---
// Shared runtime for the article's frame-player illustrations. Include ONCE per
// page. Provides the player CSS + all illustration CSS (global, tokens-only so it
// follows the site theme) and the FramePlayer controller (auto-inits every `.fp`).
---
<style is:global>
  /* ---------- FramePlayer shell ---------- */
  .fp{margin:2em 0;border:1px solid var(--color-hairline);border-radius:16px;background:var(--color-surface);padding:20px;outline:none}
  .fp:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}
  .fp-stage{position:relative;overflow-x:auto}
  .fp-bar{display:flex;align-items:center;gap:10px;margin-top:18px}
  .fp-btn{font-family:var(--font-mono);font-size:15px;line-height:1;min-width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text-muted);border-radius:8px;cursor:pointer;transition:color .15s,border-color .15s,background .15s}
  .fp-btn:hover{color:var(--color-text);border-color:var(--color-border-strong)}
  .fp-btn:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}
  .fp-cap{flex:1;margin:0;font-family:var(--font-mono);font-size:12.5px;color:var(--color-text-muted);line-height:1.5}
  .fp-dots{display:flex;gap:6px;margin-top:12px}
  .fp-dot{width:7px;height:7px;border-radius:50%;background:var(--color-border);cursor:pointer;transition:background .2s,transform .2s}
  .fp-dot.on{background:var(--color-accent);transform:scale(1.15)}
  @media (prefers-reduced-motion: reduce){.fp *{transition:none!important;animation:none!important}}

  /* ---------- #3 tokenization ---------- */
  .tok .fp-stage{min-height:150px;display:flex;align-items:center;justify-content:center}
  .tok .layer{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:0}
  .tok .sentence{font-size:clamp(20px,4vw,30px);font-weight:500;letter-spacing:-.01em;opacity:0;transition:opacity .5s}
  .tok .words{gap:10px;opacity:0;transition:opacity .5s}
  .tok[data-frame="1"] .sentence{opacity:1}
  .tok[data-frame="2"] .words,.tok[data-frame="3"] .words{opacity:1}
  .tw{display:flex;flex-direction:column;align-items:center;gap:8px}
  .tw .w{display:flex;gap:4px}
  .tw .piece{font-family:var(--font-mono);font-size:14px;background:var(--color-surface-deep);border:1px solid var(--color-border);border-radius:7px;padding:8px 10px;color:var(--color-text)}
  .tw.sp .piece{border-color:color-mix(in oklab,var(--color-accent) 45%,transparent);color:var(--color-accent)}
  .tw .ids{display:flex;gap:4px;opacity:0;transform:translateY(-4px);transition:opacity .45s,transform .45s}
  .tok[data-frame="3"] .tw .ids{opacity:1;transform:none}
  .tw .id{font-family:var(--font-mono);font-size:11.5px;color:var(--color-accent);background:color-mix(in oklab,var(--color-accent) 8%,transparent);border:1px solid color-mix(in oklab,var(--color-accent) 30%,transparent);border-radius:6px;padding:4px 7px;font-variant-numeric:tabular-nums}
  .tok .note{position:absolute;left:0;right:0;bottom:-2px;text-align:center;font-family:var(--font-mono);font-size:11.5px;color:var(--color-text-dim);opacity:0;transition:opacity .5s}
  .tok[data-frame="2"] .note,.tok[data-frame="3"] .note{opacity:1}

  /* ---------- #11 temperature ---------- */
  .temp .fp-stage{padding:8px 4px}
  .temp .chart{display:flex;align-items:flex-end;justify-content:center;gap:34px;height:200px;padding:0 10px}
  .tbar{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;width:70px;height:100%}
  .tbar .fill{width:100%;background:var(--color-accent);border-radius:8px 8px 0 0;transition:height .6s cubic-bezier(.4,0,.2,1),opacity .5s;box-shadow:0 0 18px color-mix(in oklab,var(--color-accent) 22%,transparent)}
  .tbar .nm{margin-top:10px;font-family:var(--font-mono);font-size:13px;color:var(--color-text-muted)}
  .tbar .pv{margin-bottom:7px;font-family:var(--font-mono);font-size:12.5px;color:var(--color-accent);font-variant-numeric:tabular-nums;height:16px}
  .tbar .pv i{display:none;font-style:normal}
  .temp[data-frame="1"] .pv i[data-f="1"]{display:inline}
  .temp[data-frame="2"] .pv i[data-f="2"]{display:inline}
  .temp[data-frame="3"] .pv i[data-f="3"]{display:inline}
  .temp[data-frame="4"] .pv i[data-f="4"]{display:inline}
  .temp[data-frame="1"] .fa{height:66%}.temp[data-frame="1"] .fb{height:24%}.temp[data-frame="1"] .fc{height:10%}
  .temp[data-frame="2"] .fa{height:86%}.temp[data-frame="2"] .fb{height:12%}.temp[data-frame="2"] .fc{height:2%}
  .temp[data-frame="3"] .fa{height:50%}.temp[data-frame="3"] .fb{height:30%}.temp[data-frame="3"] .fc{height:19%}
  .temp[data-frame="4"] .fa{height:73%}.temp[data-frame="4"] .fb{height:27%}.temp[data-frame="4"] .fc{height:10%;opacity:0}
  .temp[data-frame="4"] .cbar{opacity:.25}
  .temp .tag{text-align:center;margin-top:16px;font-family:var(--font-mono);font-size:12px;color:var(--color-text-dim)}
  .temp .tag b{color:var(--color-accent);font-weight:500}

  /* ---------- #6 attention ---------- */
  .attn .fp-stage{min-height:236px}
  .attn .layer{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:11px;opacity:0;transition:opacity .45s}
  .attn[data-frame="1"] .a1,.attn[data-frame="2"] .a2,.attn[data-frame="3"] .a3,.attn[data-frame="4"] .a4,.attn[data-frame="5"] .a5,.attn[data-frame="6"] .a6{opacity:1}
  .attn .ttl{font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;color:var(--color-text-faint);text-transform:uppercase;margin-bottom:2px}
  .attn .row{display:flex;align-items:center;gap:9px}
  .attn .tok{font-family:var(--font-mono);font-size:12px;color:var(--color-text-muted);min-width:34px;text-align:right}
  .attn .v{display:flex;gap:3px}
  .attn .v i{width:14px;height:14px;border-radius:3px;border:1px solid var(--color-hairline);background:color-mix(in oklab,var(--color-accent) calc(var(--v,0)*1%),var(--color-surface-2))}
  .attn .v.teal i{background:color-mix(in oklab,var(--d-teal) 60%,var(--color-surface-2))}
  .attn .ar{color:var(--color-text-dim);font-family:var(--font-mono);font-size:13px}
  .attn .qkv{display:flex;gap:7px}
  .attn .qkv b{display:flex;flex-direction:column;align-items:center;gap:3px;font-weight:400}
  .attn .qkv b em{font-family:var(--font-mono);font-size:9px;color:var(--color-text-dim);font-style:normal}
  .attn .grid{display:grid;grid-template-columns:38px repeat(3,46px);gap:5px;font-family:var(--font-mono);font-size:11px;font-variant-numeric:tabular-nums}
  .attn .grid .h{color:var(--color-text-dim);display:flex;align-items:center;justify-content:center;height:26px}
  .attn .grid .c{height:26px;border-radius:5px;background:var(--color-surface-2);border:1px solid var(--color-hairline);display:flex;align-items:center;justify-content:center;color:var(--color-text)}
  .attn .grid .c.hi{background:color-mix(in oklab,var(--color-accent) 20%,transparent);border-color:color-mix(in oklab,var(--color-accent) 45%,transparent);color:var(--color-accent)}
  .attn .cap2{font-family:var(--font-mono);font-size:10.5px;color:var(--color-text-dim)}

  /* ---------- #9 why attention (2D) ---------- */
  .wa .fp-stage{display:flex;justify-content:center;padding:4px 0}
  .wa svg{width:100%;max-width:330px;height:auto;font-family:var(--font-mono)}
  .wa .axis{stroke:var(--color-hairline);stroke-width:1}
  .wa .vec{stroke-width:2.5;fill:none;stroke-linecap:round}
  .wa .ball{stroke:var(--color-text-muted);marker-end:url(#wa-am)}
  .wa .golf{stroke:var(--color-accent);marker-end:url(#wa-aa)}
  .wa .query{stroke:var(--color-accent);stroke-dasharray:5 4;marker-end:url(#wa-aa);transform-box:view-box;transform-origin:46px 194px;transition:transform .6s cubic-bezier(.4,0,.2,1)}
  .wa[data-frame="2"] .query,.wa[data-frame="3"] .query,.wa[data-frame="4"] .query,.wa[data-frame="5"] .query{transform:rotate(-90deg)}
  .wa .result{stroke:var(--color-accent);marker-end:url(#wa-aa);opacity:0;transition:opacity .55s}
  .wa[data-frame="5"] .result,.wa[data-frame="5"] .reslab{opacity:1}
  .wa .reslab{fill:var(--color-accent);opacity:0;transition:opacity .55s}
  .wa .lab{font-size:11px;fill:var(--color-text-muted)}
  .wa .lab.a{fill:var(--color-accent)}
  .wa .score{font-size:12px;fill:var(--color-text-dim)}
  .wa .s0,.wa .s1{transition:opacity .3s}
  .wa .s1{opacity:0}
  .wa[data-frame="4"] .s0,.wa[data-frame="5"] .s0{opacity:0}
  .wa[data-frame="4"] .s1,.wa[data-frame="5"] .s1{opacity:1;fill:var(--color-accent)}
  .wa .keylab{opacity:0;transition:opacity .4s}
  .wa[data-frame="3"] .keylab,.wa[data-frame="4"] .keylab,.wa[data-frame="5"] .keylab{opacity:1}

  /* ---------- shared for remaining illustrations ---------- */
  .ill .ttl{font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;color:var(--color-text-faint);text-transform:uppercase;text-align:center}
  .ill .v{display:flex;gap:3px}
  .ill .v i{width:13px;height:13px;border-radius:3px;border:1px solid var(--color-hairline);background:color-mix(in oklab,var(--color-accent) calc(var(--v,0)*1%),var(--color-surface-2));transition:background .4s,opacity .4s}
  .ill .chip{font-family:var(--font-mono);font-size:13px;background:var(--color-surface-deep);border:1px solid var(--color-border);border-radius:7px;padding:6px 9px;color:var(--color-text)}
  .ill .pill{font-family:var(--font-mono);font-size:12.5px;border:1px solid color-mix(in oklab,var(--color-accent) 40%,transparent);background:color-mix(in oklab,var(--color-accent) 8%,transparent);color:var(--color-accent);border-radius:8px;padding:6px 11px;display:inline-flex}
  .ill .ar{color:var(--color-text-dim);font-family:var(--font-mono);font-size:13px}
  .ill .mut{font-family:var(--font-mono);font-size:11.5px;color:var(--color-text-dim)}

  /* #1 loop */
  .loop .fp-stage{min-height:172px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px}
  .loop .ctx{display:flex;gap:6px;flex-wrap:wrap;justify-content:center}
  .loop .t-mat,.loop .t-dot{opacity:.15;transition:opacity .4s}
  .loop[data-frame="3"] .t-mat,.loop[data-frame="4"] .t-mat,.loop[data-frame="5"] .t-mat{opacity:1}
  .loop[data-frame="5"] .t-dot{opacity:1}
  .loop .box{font-family:var(--font-mono);font-size:12px;border:1px solid var(--d-teal);background:var(--d-fill-soft);color:var(--color-text);border-radius:9px;padding:8px 16px}
  .loop .gen{display:flex;align-items:center;gap:8px;height:32px;opacity:0;transition:opacity .35s}
  .loop[data-frame="2"] .gen,.loop[data-frame="4"] .gen{opacity:1}
  .loop .g-mat,.loop .g-dot{display:none}
  .loop[data-frame="2"] .g-mat{display:inline-flex}
  .loop[data-frame="4"] .g-dot{display:inline-flex}
  .loop .end{opacity:0;transition:opacity .35s}
  .loop[data-frame="5"] .end{opacity:1}

  /* #2 config */
  .cfg .fp-stage{display:flex;justify-content:center;padding:4px 0}
  .cfg .panel{font-family:var(--font-mono);font-size:13px;line-height:1.95;background:var(--color-panel);border:1px solid var(--color-hairline);border-radius:12px;padding:14px 20px}
  .cfg .k{color:var(--color-text-muted)}
  .cfg .val{color:var(--color-accent)}
  .cfg .ln{display:block;border-radius:5px;padding:0 6px;margin:0 -6px;transition:background .3s}
  .cfg[data-frame="2"] .l-hs,.cfg[data-frame="3"] .l-is,.cfg[data-frame="4"] .l-nl{background:color-mix(in oklab,var(--color-accent) 14%,transparent)}
  .cfg .callout{margin-top:14px;text-align:center;font-family:var(--font-mono);font-size:12px;color:var(--color-text-dim);min-height:18px}
  .cfg .co{display:none}
  .cfg[data-frame="1"] .co-1,.cfg[data-frame="2"] .co-2,.cfg[data-frame="3"] .co-3,.cfg[data-frame="4"] .co-4{display:inline}
  .cfg .co b{color:var(--color-accent);font-weight:500}

  /* #4 embeddings */
  .emb .fp-stage{min-height:172px;display:flex;align-items:center;justify-content:center;gap:22px}
  .emb .ids{display:flex;flex-direction:column;gap:7px}
  .emb .idc{font-family:var(--font-mono);font-size:12px;color:var(--color-accent);border:1px solid color-mix(in oklab,var(--color-accent) 30%,transparent);background:color-mix(in oklab,var(--color-accent) 7%,transparent);border-radius:6px;padding:5px 9px;text-align:center}
  .emb .out{display:flex;flex-direction:column;gap:9px}
  .emb .out .row{display:flex;align-items:center;gap:9px;opacity:0;transition:opacity .4s}
  .emb[data-frame="2"] .out .r1,.emb[data-frame="3"] .out .r1{opacity:1}
  .emb[data-frame="3"] .out .r2,.emb[data-frame="3"] .out .r3{opacity:1}
  .emb .lead{font-family:var(--font-mono);font-size:11px;color:var(--color-text-muted);width:52px;text-align:right}

  /* #5 training */
  .trn .fp-stage{min-height:192px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px}
  .trn .split{display:flex;align-items:center;gap:9px}
  .trn .part{display:flex;gap:5px}
  .trn .sep{color:var(--color-text-dim);font-family:var(--font-mono);font-size:16px}
  .trn .nn,.trn .guess,.trn .err,.trn .bp{opacity:0;transition:opacity .4s}
  .trn[data-frame="2"] .nn,.trn[data-frame="3"] .nn,.trn[data-frame="4"] .nn,.trn[data-frame="2"] .guess,.trn[data-frame="3"] .guess,.trn[data-frame="4"] .guess{opacity:1}
  .trn[data-frame="3"] .err,.trn[data-frame="4"] .err{opacity:1}
  .trn[data-frame="4"] .bp{opacity:1}
  .trn .nn{font-family:var(--font-mono);font-size:12px;border:1px solid var(--d-teal);background:var(--d-fill-soft);color:var(--color-text);border-radius:9px;padding:7px 14px}
  .trn .guess{display:flex;align-items:center;gap:7px}
  .trn .guess .chip{border-color:color-mix(in oklab,var(--color-accent) 40%,transparent);color:var(--color-accent)}
  .trn .err{font-family:var(--font-mono);font-size:12px;color:var(--color-text-muted)}
  .trn .err b{color:var(--color-accent)}
  .trn .bp{font-family:var(--font-mono);font-size:11.5px;color:var(--color-text-dim)}
  .trn .first .chip{transition:border-color .4s,box-shadow .4s}
  .trn[data-frame="4"] .first .chip{border-color:color-mix(in oklab,var(--color-accent) 55%,transparent);box-shadow:0 0 9px color-mix(in oklab,var(--color-accent) 25%,transparent)}

  /* #7 ffn */
  .ffn .fp-stage{min-height:150px;display:flex;align-items:center;justify-content:center}
  .ffn .stg{display:flex;align-items:center;gap:11px;flex-wrap:wrap;justify-content:center}
  .ffn .lab{font-family:var(--font-mono);font-size:10px;color:var(--color-text-dim);text-align:center;margin-top:5px}
  .ffn .down{opacity:0;transition:opacity .4s}
  .ffn[data-frame="3"] .down{opacity:1}
  .ffn .wide .v i.weak{transition:opacity .4s}
  .ffn[data-frame="2"] .wide .v i.weak,.ffn[data-frame="3"] .wide .v i.weak{opacity:.12}

  /* #8 next word */
  .nw .fp-stage{min-height:176px;display:flex;align-items:center;justify-content:center;gap:18px}
  .nw .vecs{display:flex;flex-direction:column;gap:5px}
  .nw .vecs .v{opacity:.4;padding:2px;border-radius:4px}
  .nw .vecs .v.last{opacity:1;outline:1.5px solid color-mix(in oklab,var(--color-accent) 45%,transparent);outline-offset:1px}
  .nw .scores{display:flex;flex-direction:column;gap:6px;opacity:0;transition:opacity .4s}
  .nw[data-frame="2"] .scores,.nw[data-frame="3"] .scores{opacity:1}
  .nw .sc{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:12px}
  .nw .sc .w{width:40px;color:var(--color-text-muted);text-align:right}
  .nw .sc .bw{width:86px;height:9px;background:var(--color-surface-2);border-radius:5px;overflow:hidden}
  .nw .sc .bar{height:100%;background:var(--color-accent);border-radius:5px}
  .nw .sc .val{color:var(--color-accent);width:26px;font-variant-numeric:tabular-nums}
  .nw .tnote{opacity:0;transition:opacity .4s}
  .nw[data-frame="3"] .tnote{opacity:1}

  /* #10 why ffn (2D) */
  .wf .fp-stage{display:flex;justify-content:center;padding:4px 0}
  .wf svg{width:100%;max-width:330px;height:auto;font-family:var(--font-mono)}
  .wf .axis{stroke:var(--color-hairline);stroke-width:1}
  .wf .vec{stroke-width:2.5;fill:none;stroke-linecap:round}
  .wf .tok{stroke:var(--color-text-muted);marker-end:url(#wf-am)}
  .wf .detA{stroke:var(--color-accent);stroke-dasharray:4 4;opacity:.45;transition:opacity .4s,stroke-dasharray .1s}
  .wf .detB{stroke:var(--color-text-dim);stroke-dasharray:4 4;opacity:.45}
  .wf[data-frame="2"] .detA,.wf[data-frame="3"] .detA,.wf[data-frame="4"] .detA{opacity:1}
  .wf .result{stroke:var(--color-accent);marker-end:url(#wf-aa);opacity:0;transition:opacity .55s}
  .wf[data-frame="4"] .result,.wf[data-frame="4"] .reslab{opacity:1}
  .wf .reslab{fill:var(--color-accent);opacity:0;transition:opacity .55s}
  .wf .lab{font-size:11px;fill:var(--color-text-muted)}
  .wf .lab.a{fill:var(--color-accent)}
  .wf .fire{font-size:11px;opacity:0;transition:opacity .4s}
  .wf[data-frame="2"] .fire,.wf[data-frame="3"] .fire,.wf[data-frame="4"] .fire{opacity:1}
  .wf .fire.a{fill:var(--color-accent)}.wf .fire.d{fill:var(--color-text-dim)}

  /* ---------- #12 forward pass (full transformer) ---------- */
  .fwd .ttl{margin-bottom:12px}
  .fwd .col{display:flex;flex-direction:column;gap:7px;max-width:440px;margin:0 auto}
  .fwd .st{display:flex;align-items:center;gap:10px;border:1px solid var(--color-border);background:var(--color-surface-deep);border-radius:9px;padding:9px 13px;opacity:.4;transition:opacity .4s,border-color .4s,background .4s,box-shadow .4s}
  .fwd .lb{font-family:var(--font-mono);font-size:12.5px;color:var(--color-text-muted)}
  .fwd .lb em{color:var(--color-text-faint);font-style:normal}
  .fwd .st.mid{border-style:dashed}
  .fwd .st.out{border-color:color-mix(in oklab,var(--color-accent) 25%,var(--color-border))}
  .fwd .pred{margin-left:auto;opacity:0;transform:translateX(-5px);transition:opacity .5s,transform .5s}
  .fwd[data-frame="1"] .st:nth-child(-n+1),.fwd[data-frame="2"] .st:nth-child(-n+2),.fwd[data-frame="3"] .st:nth-child(-n+3),.fwd[data-frame="4"] .st:nth-child(-n+4),.fwd[data-frame="5"] .st:nth-child(-n+6),.fwd[data-frame="6"] .st:nth-child(-n+7){opacity:1}
  .fwd[data-frame="1"] .st.s1,.fwd[data-frame="2"] .st.s2,.fwd[data-frame="3"] .st.s3,.fwd[data-frame="4"] .st.s4,.fwd[data-frame="5"] .st.s5,.fwd[data-frame="5"] .st.s6,.fwd[data-frame="6"] .st.s7{border-color:color-mix(in oklab,var(--color-accent) 55%,transparent);background:color-mix(in oklab,var(--color-accent) 10%,transparent);box-shadow:0 0 14px color-mix(in oklab,var(--color-accent) 18%,transparent)}
  .fwd[data-frame="1"] .st.s1 .lb,.fwd[data-frame="2"] .st.s2 .lb,.fwd[data-frame="3"] .st.s3 .lb,.fwd[data-frame="4"] .st.s4 .lb,.fwd[data-frame="5"] .st.s5 .lb,.fwd[data-frame="5"] .st.s6 .lb,.fwd[data-frame="6"] .st.s7 .lb{color:var(--color-accent)}
  .fwd[data-frame="6"] .pred{opacity:1;transform:none}

  /* ---------- #13 training pass (full transformer + backprop) ---------- */
  .tp .fp-stage{display:flex;flex-direction:column;align-items:center;gap:13px}
  .tp .ttl{margin-bottom:1px}
  .tp .col{display:flex;flex-direction:column;gap:7px;width:100%;max-width:440px}
  .tp .st{display:flex;align-items:center;gap:10px;border:1px solid var(--color-border);background:var(--color-surface-deep);border-radius:9px;padding:9px 13px;opacity:.4;transition:opacity .4s,border-color .4s,background .4s,box-shadow .4s}
  .tp .lb{font-family:var(--font-mono);font-size:12.5px;color:var(--color-text-muted)}
  .tp .pred{margin-left:auto;opacity:0;transform:translateX(-5px);transition:opacity .5s,transform .5s}
  .tp .cmp{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center;font-family:var(--font-mono);font-size:12px;opacity:0;transition:opacity .45s}
  .tp .cmp .err{color:var(--color-text-muted)}
  .tp .cmp .err b{color:var(--color-accent)}
  .tp .bp{font-family:var(--font-mono);font-size:11.5px;color:var(--d-teal);text-align:center;max-width:440px;line-height:1.5;opacity:0;min-height:16px;transition:opacity .45s}
  .tp[data-frame="1"] .st:nth-child(-n+2),.tp[data-frame="2"] .st:nth-child(-n+3),.tp[data-frame="3"] .st:nth-child(-n+4),.tp[data-frame="4"] .st,.tp[data-frame="5"] .st{opacity:1}
  .tp[data-frame="1"] .st.i1,.tp[data-frame="1"] .st.i2,.tp[data-frame="2"] .st.i3,.tp[data-frame="3"] .st.i4{border-color:color-mix(in oklab,var(--color-accent) 55%,transparent);background:color-mix(in oklab,var(--color-accent) 10%,transparent);box-shadow:0 0 14px color-mix(in oklab,var(--color-accent) 18%,transparent)}
  .tp[data-frame="1"] .st.i1 .lb,.tp[data-frame="1"] .st.i2 .lb,.tp[data-frame="2"] .st.i3 .lb,.tp[data-frame="3"] .st.i4 .lb{color:var(--color-accent)}
  .tp[data-frame="3"] .pred,.tp[data-frame="4"] .pred,.tp[data-frame="5"] .pred{opacity:1;transform:none}
  .tp[data-frame="4"] .cmp,.tp[data-frame="5"] .cmp{opacity:1}
  .tp[data-frame="5"] .bp{opacity:1}
  .tp[data-frame="5"] .st{border-color:color-mix(in oklab,var(--d-teal) 50%,transparent);background:color-mix(in oklab,var(--d-teal) 9%,transparent);box-shadow:0 0 12px color-mix(in oklab,var(--d-teal) 16%,transparent)}
</style>

<script is:inline>
  class FramePlayer{
    constructor(fig){
      this.fig=fig;
      this.caps=JSON.parse(fig.dataset.captions||'[]');
      this.n=this.caps.length||1;
      this.dwell=parseInt(fig.dataset.dwell||'2400',10);
      this.i=1; this.timer=null; this.playing=false;
      this.reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.build();
      this.go(1);
      if(!this.reduce && this.n>1) this.play();
    }
    build(){
      const mk=(txt,label,fn)=>{const b=document.createElement('button');b.className='fp-btn';b.type='button';b.textContent=txt;b.setAttribute('aria-label',label);b.addEventListener('click',fn);return b;};
      this.bar=document.createElement('div'); this.bar.className='fp-bar';
      this.prevB=mk('‹','Previous frame',()=>this.step(-1));
      this.playB=mk('▶','Play',()=>this.toggle());
      this.nextB=mk('›','Next frame',()=>this.step(1));
      this.cap=document.createElement('p'); this.cap.className='fp-cap'; this.cap.setAttribute('aria-live','polite');
      this.bar.append(this.prevB,this.playB,this.nextB,this.cap);
      this.dotsEl=document.createElement('div'); this.dotsEl.className='fp-dots';
      for(let k=1;k<=this.n;k++){const d=document.createElement('span');d.className='fp-dot';d.setAttribute('role','button');d.setAttribute('aria-label','Frame '+k);d.tabIndex=0;d.addEventListener('click',()=>{this.pause();this.go(k);});this.dotsEl.appendChild(d);}
      this.fig.append(this.bar,this.dotsEl);
      this.fig.addEventListener('keydown',e=>{
        if(e.key==='ArrowLeft'){e.preventDefault();this.step(-1);}
        else if(e.key==='ArrowRight'){e.preventDefault();this.step(1);}
        else if(e.key===' '||e.key==='Spacebar'){e.preventDefault();this.toggle();}
      });
    }
    go(i){
      this.i=((i-1+this.n)%this.n)+1;
      this.fig.dataset.frame=this.i;
      this.cap.textContent=this.caps[this.i-1]||'';
      [...this.dotsEl.children].forEach((d,k)=>d.classList.toggle('on',k===this.i-1));
    }
    step(d){this.pause();this.go(this.i+d);}
    advance(){this.go(this.i+1);}
    play(){if(this.n<2)return;this.playing=true;this.playB.textContent='⏸';this.playB.setAttribute('aria-pressed','true');this.playB.setAttribute('aria-label','Pause');clearInterval(this.timer);this.timer=setInterval(()=>this.advance(),this.dwell);}
    pause(){this.playing=false;this.playB.textContent='▶';this.playB.setAttribute('aria-pressed','false');this.playB.setAttribute('aria-label','Play');clearInterval(this.timer);}
    toggle(){this.playing?this.pause():this.play();}
  }
  (function(){
    var init=function(){document.querySelectorAll('.fp').forEach(function(f){if(!f.dataset.fpReady){f.dataset.fpReady='1';new FramePlayer(f);}});};
    if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init);
    else init();
  })();
</script>
