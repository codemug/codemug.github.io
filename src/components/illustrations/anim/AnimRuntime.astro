  .p2rl .adv.ano{fill:var(--color-text-dim)}
  .p2rl[data-frame="2"] .ok rect,.p2rl[data-frame="3"] .ok rect,.p2rl[data-frame="4"] .ok rect{fill:color-mix(in oklab,var(--color-accent) 16%,var(--color-surface-2));stroke:color-mix(in oklab,var(--color-accent) 55%,transparent)}
  .p2rl[data-frame="2"] .ok text,.p2rl[data-frame="3"] .ok text,.p2rl[data-frame="4"] .ok text{fill:var(--color-accent)}
  .p2rl[data-frame="2"] .okp,.p2rl[data-frame="3"] .okp,.p2rl[data-frame="4"] .okp{stroke:var(--color-accent)}
  .p2rl[data-frame="2"] .no,.p2rl[data-frame="3"] .no{opacity:.45}
  .p2rl[data-frame="2"] .nop,.p2rl[data-frame="3"] .nop{stroke:var(--color-text-dim)}
  .p2rl[data-frame="3"] .adv,.p2rl[data-frame="4"] .adv{opacity:1}
  .p2rl[data-frame="4"] .okp{stroke-width:3.4}
  .p2rl[data-frame="4"] .nop{opacity:.12}
  .p2rl[data-frame="4"] .no{opacity:.22}

  /* KV cache (visual, SVG) */
  .p2kv .fp-stage{min-height:206px;display:flex;flex-direction:row;justify-content:center;align-items:center;padding:4px 0}
  .p2kv svg{width:100%;max-width:330px;height:auto;font-family:var(--font-mono)}
  .p2kv .tk rect{fill:var(--color-surface-2);stroke:var(--color-border);stroke-width:1;transition:fill .4s,stroke .4s}
  .p2kv .tk text{fill:var(--color-text-muted);font-size:11px;text-anchor:middle;transition:fill .4s}
  .p2kv .t3,.p2kv .t4{opacity:0;transition:opacity .45s}
  .p2kv[data-frame="3"] .t3,.p2kv[data-frame="4"] .t3,.p2kv[data-frame="5"] .t3,.p2kv[data-frame="6"] .t3{opacity:1}
  .p2kv[data-frame="6"] .t4{opacity:1}
  .p2kv[data-frame="3"] .t3 rect,.p2kv[data-frame="6"] .t4 rect{fill:color-mix(in oklab,var(--color-accent) 18%,var(--color-surface-2));stroke:color-mix(in oklab,var(--color-accent) 55%,transparent)}
  .p2kv[data-frame="3"] .t3 text,.p2kv[data-frame="6"] .t4 text{fill:var(--color-accent)}
  .p2kv .slot rect{fill:transparent;stroke:var(--color-border);stroke-width:1;stroke-dasharray:3 3;transition:fill .4s,stroke .4s,stroke-dasharray .1s}
  .p2kv .slot text{fill:var(--color-text-faint);font-size:9px;text-anchor:middle;transition:fill .4s}
  .p2kv .clabel{fill:var(--color-text-faint);font-size:8.5px;letter-spacing:.05em;text-transform:uppercase}
  .p2kv[data-frame="2"] .s1 rect,.p2kv[data-frame="3"] .s1 rect,.p2kv[data-frame="4"] .s1 rect,.p2kv[data-frame="5"] .s1 rect,.p2kv[data-frame="6"] .s1 rect,.p2kv[data-frame="2"] .s2 rect,.p2kv[data-frame="3"] .s2 rect,.p2kv[data-frame="4"] .s2 rect,.p2kv[data-frame="5"] .s2 rect,.p2kv[data-frame="6"] .s2 rect,.p2kv[data-frame="4"] .s3 rect,.p2kv[data-frame="5"] .s3 rect,.p2kv[data-frame="6"] .s3 rect{fill:color-mix(in oklab,var(--d-teal) 50%,transparent);stroke:color-mix(in oklab,var(--d-teal) 62%,transparent);stroke-dasharray:none}
  .p2kv[data-frame="2"] .s1 text,.p2kv[data-frame="2"] .s2 text,.p2kv[data-frame="3"] .s1 text,.p2kv[data-frame="3"] .s2 text,.p2kv[data-frame="4"] .s1 text,.p2kv[data-frame="4"] .s2 text,.p2kv[data-frame="4"] .s3 text,.p2kv[data-frame="5"] .s1 text,.p2kv[data-frame="5"] .s2 text,.p2kv[data-frame="5"] .s3 text,.p2kv[data-frame="6"] .s1 text,.p2kv[data-frame="6"] .s2 text,.p2kv[data-frame="6"] .s3 text{fill:var(--color-text-soft)}
  .p2kv .beams line{stroke:var(--color-accent);stroke-width:1.5;stroke-dasharray:4 3;opacity:0;transition:opacity .4s;stroke-linecap:round}
  .p2kv[data-frame="3"] .f3 line{opacity:.85}
  .p2kv[data-frame="5"] .f5 line{opacity:.85}

  /* SFT: next-token distribution collapsing */
  .p2sft .fp-stage{min-height:186px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:14px;padding:2px 0}
  .p2sft .dist{display:flex;align-items:flex-end;gap:10px;height:128px}
  .p2sft .bar{width:26px;background:color-mix(in oklab,var(--color-accent) 28%,var(--color-surface-2));border-radius:5px 5px 0 0;height:20%;transition:height .6s cubic-bezier(.4,0,.2,1),background .5s}
  .p2sft .bar.tgt{background:var(--color-accent)}
  .p2sft[data-frame="1"] .b1{height:44%}.p2sft[data-frame="1"] .b2{height:58%}.p2sft[data-frame="1"] .b3{height:50%}.p2sft[data-frame="1"] .b4{height:63%}.p2sft[data-frame="1"] .b5{height:47%}.p2sft[data-frame="1"] .b6{height:55%}.p2sft[data-frame="1"] .b7{height:40%}
  .p2sft[data-frame="2"] .b1{height:32%}.p2sft[data-frame="2"] .b2{height:38%}.p2sft[data-frame="2"] .b3{height:74%}.p2sft[data-frame="2"] .b4{height:40%}.p2sft[data-frame="2"] .b5{height:30%}.p2sft[data-frame="2"] .b6{height:36%}.p2sft[data-frame="2"] .b7{height:26%}
  .p2sft[data-frame="3"] .bar{height:13%}
  .p2sft[data-frame="3"] .b3{height:96%}
  .p2sft .xa{display:flex;flex-direction:column;align-items:center;gap:3px}
  .p2sft .xa .mut{font-family:var(--font-mono);font-size:10.5px}
  .p2sft .xa .tl{font-family:var(--font-mono);font-size:11.5px;color:var(--color-accent);opacity:0;transition:opacity .5s}
  .p2sft[data-frame="3"] .xa .tl{opacity:1}

  /* chat template: token stream */
  .p2tmpl .fp-stage{min-height:190px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:11px;padding:2px 0}
  .p2tmpl .bubble{font-family:var(--font-mono);font-size:12px;color:var(--color-text-muted);background:var(--color-surface-deep);border:1px solid var(--color-border);border-radius:10px;padding:7px 12px}
  .p2tmpl .down{font-family:var(--font-mono);font-size:14px;color:var(--color-text-dim)}
  .p2tmpl .stream{display:flex;flex-wrap:wrap;gap:4px;justify-content:center;max-width:400px;opacity:0;transition:opacity .45s}
  .p2tmpl[data-frame="2"] .stream,.p2tmpl[data-frame="3"] .stream{opacity:1}
  .p2tmpl .tk{font-family:var(--font-mono);font-size:11px;border:1px solid var(--color-border);background:var(--color-surface-2);color:var(--color-text-muted);border-radius:5px;padding:4px 7px}
  .p2tmpl .tk.ctl{border-color:color-mix(in oklab,var(--color-accent) 45%,transparent);background:color-mix(in oklab,var(--color-accent) 12%,transparent);color:var(--color-accent)}
  .p2tmpl .cue{transition:opacity .3s}
  .p2tmpl[data-frame="3"] .cue{opacity:.28;text-decoration:line-through}
  .p2tmpl .warn{font-family:var(--font-mono);font-size:11px;color:var(--color-text-dim);opacity:0;transition:opacity .4s;min-height:15px}
  .p2tmpl[data-frame="3"] .warn{opacity:1}

  /* reward source: verifier + meter */
  .p2rew .fp-stage{min-height:150px;display:flex;flex-direction:column;justify-content:center;gap:20px;padding:2px 0}
  .p2rew .lane{display:flex;align-items:center;gap:8px;justify-content:center;flex-wrap:wrap;opacity:.24;transition:opacity .4s}
  .p2rew[data-frame="1"] .v,.p2rew[data-frame="2"] .r{opacity:1}
  .p2rew .lb{font-family:var(--font-mono);font-size:9px;text-transform:uppercase;color:var(--color-text-faint);width:58px;text-align:right}
  .p2rew .gate,.p2rew .rm{font-family:var(--font-mono);font-size:11.5px;color:var(--color-text-muted);border:1px solid var(--color-border);border-radius:7px;padding:6px 10px}
  .p2rew .tick{color:var(--color-accent);font-size:16px}
  .p2rew .rv{font-family:var(--font-mono);font-size:13px;color:var(--color-accent);font-variant-numeric:tabular-nums}
  .p2rew .meter{width:72px;height:14px;border-radius:7px;background:var(--color-surface-2);border:1px solid var(--color-border);overflow:hidden;position:relative}
  .p2rew .meter .fill{position:absolute;left:0;top:0;bottom:0;width:0;background:var(--color-accent);transition:width .7s cubic-bezier(.4,0,.2,1)}
  .p2rew[data-frame="2"] .meter .fill{width:82%}

  /* DPO: balance tips toward chosen */
  .p2dpo .fp-stage{min-height:180px;display:flex;justify-content:center;align-items:center;padding:2px 0}
  .p2dpo svg{width:100%;max-width:300px;height:auto;font-family:var(--font-mono)}
  .p2dpo .post{stroke:var(--color-border-strong);stroke-width:2}
  .p2dpo .pivot{fill:var(--color-border-strong)}
  .p2dpo .arm{stroke:var(--color-text-muted);stroke-width:2.5;stroke-linecap:round}
  .p2dpo .hang{stroke:var(--color-border);stroke-width:1}
  .p2dpo .pan rect{fill:var(--color-surface-2);stroke:var(--color-border);stroke-width:1;transition:fill .5s,stroke .5s,opacity .5s}
  .p2dpo .pan text{fill:var(--color-text-muted);font-size:11px;text-anchor:middle;transition:fill .5s}
  .p2dpo .beam{transform-box:view-box;transform-origin:150px 64px;transition:transform .7s cubic-bezier(.4,0,.2,1)}
  .p2dpo[data-frame="2"] .beam{transform:rotate(9deg)}
  .p2dpo[data-frame="2"] .cho rect{fill:color-mix(in oklab,var(--color-accent) 18%,var(--color-surface-2));stroke:color-mix(in oklab,var(--color-accent) 55%,transparent)}
  .p2dpo[data-frame="2"] .cho text{fill:var(--color-accent)}
  .p2dpo[data-frame="2"] .rej{opacity:.4}

  /* tensor core: systolic grid */
  .p2tc .fp-stage{min-height:180px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:14px;padding:2px 0}
  .p2tc .tcrow{display:flex;align-items:center;gap:12px}
  .p2tc .lfeed{font-family:var(--font-mono);font-size:9.5px;color:var(--color-text-faint);text-transform:uppercase;text-align:right;max-width:40px;line-height:1.3}
  .p2tc .sys{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;padding:6px;border:1px solid var(--color-border);border-radius:8px;background:var(--color-surface-deep);transition:box-shadow .4s}
  .p2tc .sys i{width:22px;height:22px;border-radius:4px;background:var(--color-surface-2);border:1px solid var(--color-hairline);transition:background .4s,border-color .4s}
  .p2tc[data-frame="2"] .sys i,.p2tc[data-frame="3"] .sys i{background:color-mix(in oklab,var(--color-accent) 45%,var(--color-surface-2));border-color:color-mix(in oklab,var(--color-accent) 40%,transparent)}
  .p2tc[data-frame="2"] .sys,.p2tc[data-frame="3"] .sys{box-shadow:0 0 16px color-mix(in oklab,var(--color-accent) 16%,transparent)}
  .p2tc .rout{display:flex;align-items:center;gap:8px;opacity:.22;transition:opacity .4s}
  .p2tc[data-frame="3"] .rout{opacity:1}
  .p2tc .wr{font-family:var(--font-mono);color:var(--color-text-dim);font-size:14px}
  .p2tc .mem{font-family:var(--font-mono);font-size:11px;color:var(--color-text-muted);border:1px solid var(--color-border);border-radius:7px;padding:6px 9px}
  .p2tc .note{font-family:var(--font-mono);font-size:11px;color:var(--color-text-dim);text-align:center;max-width:400px}

  /* why cache K,V: transient query vs accumulating K,V */
  .p2wc .fp-stage{min-height:170px;display:flex;justify-content:center;align-items:center;padding:2px 0}
  .p2wc svg{width:100%;max-width:300px;height:auto;font-family:var(--font-mono)}
  .p2wc .rlab{fill:var(--color-text-faint);font-size:10px;text-transform:uppercase;letter-spacing:.04em}
  .p2wc .qd{fill:color-mix(in oklab,var(--color-accent) 55%,var(--color-surface-2));stroke:color-mix(in oklab,var(--color-accent) 45%,transparent);stroke-width:1;opacity:0;transition:opacity .4s}
  .p2wc[data-frame="1"] .q1,.p2wc[data-frame="2"] .q2,.p2wc[data-frame="3"] .q3{opacity:1}
  .p2wc .kd{fill:color-mix(in oklab,var(--d-teal) 58%,var(--color-surface-2));stroke:color-mix(in oklab,var(--d-teal) 50%,transparent);stroke-width:1;opacity:.12;transition:opacity .4s}
  .p2wc[data-frame="1"] .k1,.p2wc[data-frame="2"] .k1,.p2wc[data-frame="3"] .k1,.p2wc[data-frame="2"] .k2,.p2wc[data-frame="3"] .k2,.p2wc[data-frame="3"] .k3{opacity:1}

  /* prefill vs decode: tokens per weight-read */
  .p2pd .fp-stage{min-height:172px;display:flex;flex-direction:column;justify-content:center;gap:20px;padding:2px 0}
  .p2pd .prow{display:flex;align-items:center;gap:10px;justify-content:center;opacity:.28;transition:opacity .4s}
  .p2pd[data-frame="1"] .pre,.p2pd[data-frame="2"] .dec{opacity:1}
  .p2pd .pl{font-family:var(--font-mono);font-size:10px;text-transform:uppercase;color:var(--color-text-faint);width:52px;text-align:right}
  .p2pd .wl{font-family:var(--font-mono);font-size:11px;color:var(--color-text-muted);border:1px solid var(--color-border-strong);border-radius:6px;padding:8px 9px;background:var(--color-surface-2)}
  .p2pd .toks{display:flex;gap:3px}
  .p2pd .toks i{width:13px;height:20px;border-radius:3px;background:var(--color-surface-2);border:1px solid var(--color-hairline)}
  .p2pd .pre .toks i{background:color-mix(in oklab,var(--color-accent) 52%,var(--color-surface-2));border-color:color-mix(in oklab,var(--color-accent) 40%,transparent)}
  .p2pd .dec .toks i.on{background:color-mix(in oklab,var(--color-accent) 52%,var(--color-surface-2));border-color:color-mix(in oklab,var(--color-accent) 40%,transparent)}
  .p2pd .pdkey{text-align:center;font-family:var(--font-mono);font-size:10.5px;color:var(--color-text-dim)}

  /* quantization: snap to coarser levels on a number line */
  .p2bit .fp-stage{min-height:170px;display:flex;justify-content:center;align-items:center;padding:2px 0}
  .p2bit svg{width:100%;max-width:300px;height:auto;font-family:var(--font-mono)}
  .p2bit .axis{stroke:var(--color-border);stroke-width:1.5}
  .p2bit .fine line{stroke:var(--color-hairline);stroke-width:1}
  .p2bit .coarse line{stroke:var(--color-text-dim);stroke-width:1.5}
  .p2bit .fine{transition:opacity .4s}
  .p2bit .coarse{opacity:0;transition:opacity .4s}
  .p2bit[data-frame="2"] .fine,.p2bit[data-frame="3"] .fine{opacity:0}
  .p2bit[data-frame="2"] .coarse,.p2bit[data-frame="3"] .coarse{opacity:1}
  .p2bit .marker{transform-box:view-box;transform:translateX(192px);transition:transform .6s cubic-bezier(.4,0,.2,1)}
  .p2bit[data-frame="2"] .marker,.p2bit[data-frame="3"] .marker{transform:translateX(215px)}
  .p2bit .stem{stroke:var(--color-accent);stroke-width:1.5}
  .p2bit .dot{fill:var(--color-accent)}
  .p2bit .vlab{fill:var(--color-accent);font-size:11px;text-anchor:middle}
  .p2bit .v2{opacity:0;transition:opacity .4s}
  .p2bit .v1{transition:opacity .4s}
  .p2bit[data-frame="2"] .v1,.p2bit[data-frame="3"] .v1{opacity:0}
  .p2bit[data-frame="2"] .v2,.p2bit[data-frame="3"] .v2{opacity:1}

  /* #13 ffn matrices (2D grids) */
  .fmx .fp-stage{display:flex;justify-content:center;padding:6px 0}
  .fmx svg{width:100%;max-width:340px;height:auto;font-family:var(--font-mono)}
  .fmx .cell{fill:var(--color-surface-2);stroke:var(--color-hairline)}
  .fmx .out{fill:color-mix(in oklab,var(--color-accent) 20%,var(--color-surface-2));stroke:color-mix(in oklab,var(--color-accent) 50%,transparent)}
  .fmx .grid{fill:color-mix(in oklab,var(--color-accent) 8%,var(--color-surface-2));stroke:color-mix(in oklab,var(--color-accent) 30%,transparent)}
  .fmx .gl{stroke:var(--color-hairline);stroke-width:.75}
  .fmx .op{fill:var(--color-text-dim);font-size:15px;text-anchor:middle}
  .fmx .lab{fill:var(--color-text-muted);font-size:10px;text-anchor:middle}
  .fmx .dim{fill:var(--color-text-dim);font-size:9px;text-anchor:middle}
  .fmx .up{transition:opacity .4s}
  .fmx .dn{opacity:0;transition:opacity .4s}
  .fmx[data-frame="2"] .up{opacity:0}
  .fmx[data-frame="2"] .dn{opacity:1}

  /* #14 relu (zero baseline) */
  .frl .fp-stage{display:flex;justify-content:center;padding:6px 0}
  .frl svg{width:100%;max-width:330px;height:auto;font-family:var(--font-mono)}
  .frl .base{stroke:var(--color-border-strong);stroke-width:1;stroke-dasharray:3 3}
  .frl .zero{fill:var(--color-text-dim);font-size:10px}
  .frl .pos{fill:color-mix(in oklab,var(--color-accent) 52%,var(--color-surface-2))}
  .frl .neg{fill:color-mix(in oklab,var(--color-text-dim) 45%,var(--color-surface-2));transition:opacity .45s}
  .frl[data-frame="2"] .neg{opacity:0}
  .frl .tag{font-size:10.5px;text-anchor:middle;opacity:0;transition:opacity .4s}
  .frl .tag.n{fill:var(--color-text-dim)}
  .frl .tag.k{fill:var(--color-accent)}
  .frl[data-frame="1"] .tag.n{opacity:1}
  .frl[data-frame="2"] .tag.k{opacity:1}

  /* #15 ffn detector (fires, writes spain) */
  .fdet .fp-stage{display:flex;justify-content:center;padding:4px 0}
  .fdet svg{width:100%;max-width:360px;height:auto;font-family:var(--font-mono)}
  .fdet .pill{fill:var(--color-surface-2);stroke:var(--color-border)}
  .fdet .ptxt{fill:var(--color-text-muted);font-size:10px;text-anchor:middle}
  .fdet .wlab{fill:var(--color-text-faint);font-size:9.5px;text-anchor:middle;letter-spacing:.04em}
  .fdet .chip rect{fill:var(--color-surface-deep);stroke:var(--color-border);transition:fill .4s,stroke .4s}
  .fdet .chip text{fill:var(--color-text-dim);font-size:10px;text-anchor:middle;transition:fill .4s}
  .fdet .dim{transition:opacity .4s}
  .fdet[data-frame="2"] .dim,.fdet[data-frame="3"] .dim{opacity:.32}
  .fdet[data-frame="2"] .d3 rect,.fdet[data-frame="3"] .d3 rect{fill:color-mix(in oklab,var(--color-accent) 16%,var(--color-surface-deep));stroke:color-mix(in oklab,var(--color-accent) 55%,transparent)}
  .fdet[data-frame="2"] .d3 text,.fdet[data-frame="3"] .d3 text{fill:var(--color-accent)}
  .fdet .wb{opacity:0;transition:opacity .5s}
  .fdet[data-frame="3"] .wb{opacity:1}
  .fdet .arrow{stroke:var(--color-accent);stroke-width:1.5;fill:none;marker-end:url(#fd-a)}
  .fdet .wdlab{fill:var(--color-text-muted);font-size:9.5px}
  .fdet .spin{fill:color-mix(in oklab,var(--color-accent) 20%,var(--color-surface-2));stroke:color-mix(in oklab,var(--color-accent) 55%,transparent)}
  .fdet .spintx{fill:var(--color-accent);font-size:12px;text-anchor:middle}

  /* ===== Primer figures: shared toolkit ===== */
  .pf .fp-stage{min-height:216px;display:flex;align-items:center;justify-content:center;padding:10px 0}
  .pf .scene{display:flex;flex-direction:column;align-items:center;gap:14px;width:100%;max-width:520px;margin:0 auto;text-align:center}
  .pf .row{display:flex;align-items:center;justify-content:center;gap:11px;flex-wrap:wrap}
  .pf .col{display:flex;flex-direction:column;align-items:center;gap:10px}
  .pf .box{font-family:var(--font-mono);font-size:12px;color:var(--color-text-soft);background:var(--color-surface-deep);border:1px solid var(--color-border);border-radius:10px;padding:9px 13px;transition:opacity .45s,border-color .4s,background .4s,transform .45s}
  .pf .box.acc{border-color:color-mix(in oklab,var(--color-accent) 48%,transparent);color:var(--color-accent);background:color-mix(in oklab,var(--color-accent) 9%,transparent)}
  .pf .box.warn{border-color:color-mix(in oklab,#e0645c 52%,transparent);color:#e0645c;background:color-mix(in oklab,#e0645c 9%,transparent)}
  .pf .mn{font-family:var(--font-mono);font-size:11px;color:var(--color-text-dim);text-align:center;line-height:1.5}
  .pf .mn b,.pf b{font-weight:500;color:var(--color-text-soft)}
  .pf b.acc{color:var(--color-accent)} .pf b.bad{color:#e0645c}
  .pf .arr{font-family:var(--font-mono);color:var(--color-text-dim);font-size:15px}
  .pf .chip2{font-family:var(--font-mono);font-size:11px;color:var(--color-text-muted);background:var(--color-surface-2);border:1px solid var(--color-border);border-radius:7px;padding:6px 9px;white-space:nowrap}
