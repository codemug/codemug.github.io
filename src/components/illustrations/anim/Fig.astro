---
// One animated illustration, chosen by `name`. Requires <AnimRuntime /> once on
// the page (it provides the styles + the player that auto-inits every `.fp`).
interface Props { name: string; }
const { name } = Astro.props;
---
{name === "primer-vram" && (
  <figure class="fp ill pf pr1" tabindex="0" data-dwell="2600" data-captions='["A 12B model at 16-bit precision needs about 24 GB. It does not fit in a 16 GB budget.","Quantise to 8-bit and it is about 12 GB. Now it fits, but only just.","Quantise to 4-bit and it is about 6 GB, leaving room for the KV cache and activations."]'>
    <div class="fp-stage"><div class="scene">
      <div class="track"><div class="ceil"><span>16 GB budget</span></div><div class="bar"></div></div>
      <div class="stack rd">
        <span class="o1">16-bit &middot; &#8776; 24 GB &middot; <b class="bad">over budget</b></span>
        <span class="o2">8-bit &middot; &#8776; 12 GB &middot; <b class="acc">fits</b></span>
        <span class="o3">4-bit &middot; &#8776; 6 GB &middot; <b class="acc">room to spare</b></span>
      </div>
    </div></div>
  </figure>
)}

{name === "primer-dilution" && (
  <figure class="fp ill pf pr2" tabindex="0" data-dwell="2700" data-captions='["A short, tight prompt: the handful of tokens that matter get a big, clean share of attention.","Add history and tool definitions, and the same tokens now share the budget with distractors.","A giant prompt buries the signal. Each distractor takes only a sliver, but there are thousands.","Lost in the middle: the same fact is found at the edges, and missed when buried in the centre."]'>
    <div class="fp-stage"><div class="scene"><div class="stack">
      <div class="dil col">
        <div class="budget"><span class="key"></span><span class="rest"></span></div>
        <div class="stack sig">
          <span class="o1">signal <b class="acc">strong</b></span>
          <span class="o2">signal <b>fading</b></span>
          <span class="o3">signal <b class="bad">buried</b></span>
        </div>
        <div class="lg"><span class="sw acc"></span>tokens that matter<span class="sw dim"></span>everything else</div>
      </div>
      <div class="lim col">
        <div class="ctxbar"><span class="fact"></span></div>
        <div class="mn">start <b class="acc">found</b> &middot; middle <b class="bad">missed</b> &middot; end <b class="acc">found</b></div>
      </div>
    </div></div></div>
  </figure>
)}

{name === "primer-split" && (
  <figure class="fp ill pf pr3" tabindex="0" data-dwell="2600" data-captions='["One agent holds the whole task at once: a bloated context where the signal is buried.","Split it up. A writer, handed only what it needs for its one job.","A checker and a summariser, each with its own small, clean context.","And a decider. No single call holds the whole task, so no single call ever gets buried."]'>
    <div class="fp-stage"><div class="scene"><div class="stack">
      <div class="o1 col">
        <div class="box warn">one agent &middot; write &middot; check &middot; summarise &middot; decide</div>
        <div class="meter w"><i style="width:94%"></i></div>
        <div class="mn">context overloaded</div>
      </div>
      <div class="many col f2">
        <div class="row">
          <div class="ag">writer<div class="meter"><i style="width:26%"></i></div></div>
          <div class="ag f3">checker<div class="meter"><i style="width:24%"></i></div></div>
          <div class="ag f3">summariser<div class="meter"><i style="width:28%"></i></div></div>
          <div class="ag f4">decider<div class="meter"><i style="width:22%"></i></div></div>
        </div>
        <div class="mn f4">each with its own perfect context</div>
      </div>
    </div></div></div>
  </figure>
)}

{name === "primer-toolsearch" && (
  <figure class="fp ill pf pr4" tabindex="0" data-dwell="2700" data-captions='["The old way: paste every tool definition into the prompt. Fifty tools rebuild the bloat.","Move the whole catalogue into a search index, out of the prompt.","Give the agent two meta-tools instead of fifty real ones: one to search, one to call by id.","It describes what it needs, gets the best two or three matches, and calls one."]'>
    <div class="fp-stage"><div class="scene"><div class="stack">
      <div class="o1 col">
        <div class="box warn"><div>prompt</div><div class="cluster" style="margin-top:7px"><span class="tc"></span><span class="tc"></span><span class="tc"></span><span class="tc"></span><span class="tc"></span><span class="tc"></span><span class="tc"></span><span class="tc"></span><span class="tc"></span><span class="tc"></span><span class="tc"></span><span class="tc"></span></div></div>
        <div class="mn">50 tool definitions crammed in</div>
      </div>
      <div class="o2 row">
        <div class="box">prompt</div><span class="arr">&rarr;</span><div class="box acc">search index<div class="mn">50 tools</div></div>
      </div>
      <div class="o3 col">
        <div class="row"><div class="box acc">agent</div><span class="chip2">search()</span><span class="chip2">call(id)</span></div>
        <div class="mn">the catalogue lives in the index, not the prompt</div>
      </div>
      <div class="o4 col">
        <div class="row"><span class="chip2 hi">"summarise a PDF"</span><span class="arr">&rarr;</span><span class="chip2">match A</span><span class="chip2 hi">match B</span><span class="chip2">match C</span></div>
        <div class="mn">describe the need, get 2 or 3 matches, call one</div>
      </div>
    </div></div></div>
  </figure>
)}

{name === "primer-surface" && (
  <figure class="fp ill pf pr5" tabindex="0" data-dwell="2600" data-captions='["The agent itself carries only a small context.","Around it sit large, searchable catalogues: tools, agents, graphs, collections, docs.","It expands only the branch it is standing on, and leaves everything else indexed and out of the way."]'>
    <div class="fp-stage"><div class="scene">
      <div class="box acc">agent<div class="mn">small context</div></div>
      <span class="arr f2">&#8597;</span>
      <div class="row f2">
        <span class="cat">tools</span><span class="cat hl">agents</span><span class="cat">graphs</span><span class="cat">collections</span><span class="cat">docs</span>
      </div>
      <div class="mn f2">large searchable surface, indexed and out of the way</div>
    </div></div>
  </figure>
)}

{name === "primer-workspace" && (
  <figure class="fp ill pf pr6" tabindex="0" data-dwell="2600" data-captions='["Two agents, each running in its own private context.","Between them, one shared thing: a folder, and a place to run commands.","One rule keeps them honest: read a file before you overwrite it, so neither stomps the other.","Rich tooling turns out to be structured files. A task list is just a file with checkboxes."]'>
    <div class="fp-stage"><div class="scene">
      <div class="row"><div class="box acc">agent A</div><div class="box acc">agent B</div></div>
      <div class="col f2"><div class="mn">workspace</div><div class="row"><span class="chip2">shared folder</span><span class="chip2">run commands</span></div></div>
      <div class="mn f3">rule: read before you overwrite</div>
      <div class="file f4"><span><b class="acc">[x]</b> draft outline</span><span><b class="acc">[x]</b> write section</span><span>[ ] review</span></div>
    </div></div>
  </figure>
)}

{name === "primer-loop" && (
  <figure class="fp ill pf pr7" tabindex="0" data-dwell="2700" data-captions='["A producer writes something.","A judge reads it and decides: accept, or reject with specific feedback.","Reject sends it back with feedback. The producer revises, and the judge looks again.","Round and round until it is good enough. A hard cap keeps a loop from running forever."]'>
    <div class="fp-stage"><div class="scene">
      <div class="row"><div class="box acc">producer<div class="mn">writes</div></div><span class="arr">&rarr;</span><div class="box f2">judge<div class="mn">critiques</div></div></div>
      <div class="row f3"><span class="rj">&larr; reject: back with feedback</span></div>
      <div class="row f3"><span class="it">iteration <b>3</b> &middot; cap 8</span></div>
      <div class="row f4"><span class="ac">accept &rarr; done</span></div>
    </div></div>
  </figure>
)}

{name === "primer-events" && (
  <figure class="fp ill pf pr8" tabindex="0" data-dwell="2700" data-captions='["A chain of agents is running on a worker.","It reaches a point where it has to wait, so it yields: it saves its state and frees the worker.","Parked, it waits on a human, a schedule, or an event, holding nothing open.","When the trigger arrives, the run is picked back up exactly where it left off."]'>
    <div class="fp-stage"><div class="scene"><div class="stack">
      <div class="o1 col"><div class="row"><div class="box acc">run</div><span class="chip2">worker</span></div><div class="mn">running</div></div>
      <div class="o2 col"><div class="row"><div class="box">run</div><span class="arr">&rarr;</span><span class="chip2">saved state</span></div><div class="mn">yields and frees the worker</div></div>
      <div class="o3 col"><div class="box">run &middot; <b class="acc">parked</b></div><div class="row"><span class="chip2">human</span><span class="chip2">schedule</span><span class="chip2">event</span></div><div class="mn">nothing held open, only saved state</div></div>
      <div class="o4 col"><div class="row"><span class="chip2 hi">trigger</span><span class="arr">&rarr;</span><div class="box acc">run resumes</div></div><div class="mn">picks up where it left off</div></div>
    </div></div></div>
  </figure>
)}

{name === "primer-approval" && (
  <figure class="fp ill pf pr9" tabindex="0" data-dwell="2700" data-captions='["Any agent can pull in live information through one clean web-search tool.","A sensitive tool call does not just run. It hits a gate first.","The run parks at the gate and waits for a human to sign off.","Approved, it continues. Denied, it records the denial and moves on."]'>
    <div class="fp-stage"><div class="scene"><div class="stack">
      <div class="o1 row"><div class="box acc">agent</div><span class="arr">&rarr;</span><div class="box">web search</div></div>
      <div class="o2 row"><div class="box acc">agent</div><span class="arr">&rarr;</span><div class="box warn">gate</div><span class="arr">&rarr;</span><div class="box">sensitive tool</div></div>
      <div class="o3 col"><div class="box warn">gate &middot; waiting</div><div class="mn">a human signs off before it runs</div></div>
      <div class="o4 row"><span class="ok">approved &rarr; runs</span><span class="no">denied &rarr; recorded</span></div>
    </div></div></div>
  </figure>
)}

{name === "primer-harness" && (
  <figure class="fp ill pf pr10" tabindex="0" data-dwell="2600" data-captions='["A setup you tuned over many passes: agents, tools, collections, and a graph that wires them.","Bundle it into a harness, a git-backed package of that whole configuration.","Someone else installs it in one step, and skips all the iteration.","A community piles up and trades these tuned configs, each a packaged answer to one job."]'>
    <div class="fp-stage"><div class="scene"><div class="stack">
      <div class="o1 row"><span class="chip2">agents</span><span class="chip2">tools</span><span class="chip2">collections</span><span class="chip2">graph</span></div>
      <div class="o2 col"><div class="box acc">harness<div class="mn">git-backed bundle</div></div></div>
      <div class="o3 row"><div class="box acc">harness</div><span class="arr">&rarr;</span><div class="box">installed in one step</div></div>
      <div class="o4 row"><div class="box acc">harness</div><div class="box acc">harness</div><div class="box acc">harness</div></div>
    </div></div></div>
  </figure>
)}

{name === "hw-three-levers" && (
  <figure class="fp ill pf hwl" tabindex="0" data-dwell="2900" data-captions='["Capacity: the model has to fit. A 27 GB model does not fit in 16 GB of VRAM.","Compute: a chip with native 4-bit hardware multiplies straight away; without it, every weight is converted up to 16-bit first.","Bandwidth: decode re-reads the weights every token, so local memory speed sets the pace, and it dwarfs the link between chips."]'>
    <div class="fp-stage"><div class="scene"><div class="stack">
      <div class="o1 col">
        <div class="caprow"><span class="cl">VRAM</span><div class="vbox">16 GB</div></div>
        <div class="caprow"><span class="cl">model</span><div class="mbar">27 GB<span class="over">overflows</span></div></div>
        <div class="mn">does not fit</div>
      </div>
      <div class="o2 col">
        <div class="crow"><span class="ctag">no native 4-bit</span><span class="chip2">4-bit</span><span class="arr">&rarr;</span><span class="chip2">16-bit</span><span class="arr">&rarr;</span><span class="chip2">multiply</span></div>
        <div class="crow"><span class="ctag on">native 4-bit</span><span class="chip2 hi">4-bit</span><span class="arr">&rarr;</span><span class="chip2 hi">multiply</span></div>
        <div class="mn">native hardware skips the conversion</div>
      </div>
      <div class="o3 col">
        <div class="brow"><span class="bl">memory</span><div class="bt"><div class="bf h" style="width:100%"></div></div><span class="bv">2 TB/s</span></div>
        <div class="brow"><span class="bl">interconnect</span><div class="bt"><div class="bf g" style="width:3%"></div></div><span class="bv">60 GB/s</span></div>
        <div class="mn">weights stream from memory, not across the wire</div>
      </div>
    </div></div></div>
  </figure>
)}

{name === "mem-bandwidth-ladder" && (
  <figure class="fp ill pf mbl" tabindex="0" data-dwell="2800" data-captions='["Consumer GDDR memory tops out under 2 TB/s.","Datacenter HBM starts where GDDR ends and climbs to about 8 TB/s. Decode speed rides this bar."]'>
    <div class="fp-stage"><div class="scene">
      <div class="bars">
        <div class="brow"><span class="bl">A10G · GDDR6</span><div class="bt"><div class="bf g" style="width:7.5%"></div></div><span class="bv">0.6</span></div>
        <div class="brow"><span class="bl">RTX PRO 6000 · GDDR7</span><div class="bt"><div class="bf g" style="width:22.5%"></div></div><span class="bv">1.8</span></div>
        <div class="brow f2"><span class="bl">H100 · HBM3</span><div class="bt"><div class="bf h" style="width:42%"></div></div><span class="bv">3.4</span></div>
        <div class="brow f2"><span class="bl">H200 · HBM3e</span><div class="bt"><div class="bf h" style="width:60%"></div></div><span class="bv">4.8</span></div>
        <div class="brow f2"><span class="bl">B200 · HBM3e</span><div class="bt"><div class="bf h" style="width:100%"></div></div><span class="bv">8.0</span></div>
      </div>
      <div class="mn">memory bandwidth, TB/s</div>
    </div></div>
  </figure>
)}

{name === "interconnect" && (
  <figure class="fp ill tpx" tabindex="0" data-dwell="2900" data-captions='["The model is split across the GPUs: each holds a slice of the weights in every layer. A token comes in.","Every GPU runs its slice on the token and produces a partial result.","They exchange the partials over the interconnect and add them up, an all-reduce, so each GPU has the full result.","Then the next block does the same. This exchange happens after every block, at the speed of the wire between the GPUs."]'>
    <div class="fp-stage">
      <svg viewBox="0 0 320 224" role="img" aria-label="Tensor parallelism: three GPUs each run a weight slice, then combine partial results in an all-reduce">
        <defs>
          <marker id="tpa" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 z" fill="var(--color-accent)"></path></marker>
          <marker id="tpm" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 z" fill="var(--color-text-dim)"></path></marker>
        </defs>
        <rect class="ib" x="124" y="10" width="72" height="24" rx="7"></rect><text class="it" x="160" y="26">token</text>
        <line class="feed" x1="150" y1="34" x2="66" y2="68"></line>
        <line class="feed" x1="160" y1="34" x2="160" y2="68"></line>
        <line class="feed" x1="170" y1="34" x2="254" y2="68"></line>
        <g class="gpu"><rect x="20" y="70" width="80" height="46" rx="9"></rect><text x="60" y="90">GPU 1</text><text class="sub" x="60" y="105">weight slice</text></g>
        <g class="gpu"><rect x="120" y="70" width="80" height="46" rx="9"></rect><text x="160" y="90">GPU 2</text><text class="sub" x="160" y="105">weight slice</text></g>
        <g class="gpu"><rect x="220" y="70" width="80" height="46" rx="9"></rect><text x="260" y="90">GPU 3</text><text class="sub" x="260" y="105">weight slice</text></g>
        <text class="partial f2" x="60" y="132">partial</text>
        <text class="partial f2" x="160" y="132">partial</text>
        <text class="partial f2" x="260" y="132">partial</text>
        <g class="f3">
          <line class="xl" x1="60" y1="136" x2="146" y2="158"></line>
          <line class="xl" x1="160" y1="136" x2="160" y2="158"></line>
          <line class="xl" x1="260" y1="136" x2="174" y2="158"></line>
          <rect class="arb" x="116" y="160" width="88" height="24" rx="8"></rect><text class="art" x="160" y="176">all-reduce</text>
        </g>
        <path class="loop f4" d="M204,172 C 296,158 300,44 198,32"></path>
        <text class="rep f4" x="300" y="104" text-anchor="end">every block</text>
      </svg>
    </div>
  </figure>
)}

{name === "dedicated-vs-unified" && (
  <figure class="fp ill pf dvu" tabindex="0" data-dwell="2700" data-captions='["Dedicated memory: the GPU has its own fast VRAM, the CPU its own separate RAM.","Unified memory: CPU and GPU share one big pool. More capacity, but slower bandwidth."]'>
    <div class="fp-stage"><div class="scene"><div class="stack">
      <div class="o1 row">
        <div class="unit"><div class="box">CPU</div><div class="pool sys">system RAM</div></div>
        <span class="arr">|</span>
        <div class="unit"><div class="box acc">GPU</div><div class="pool vram">VRAM<div class="mn2">small · fast</div></div></div>
      </div>
      <div class="o2 col">
        <div class="row"><div class="box">CPU</div><div class="box acc">GPU</div></div>
        <div class="pool unif">one shared pool<div class="mn2">large · slower</div></div>
      </div>
    </div></div></div>
  </figure>
)}

{name === "apple-soc" && (
  <figure class="fp ill asoc" tabindex="0" data-dwell="2900" data-captions='["Everything on an Apple chip shares one pool of unified memory.","Three kinds of compute sit on it: the CPU, the GPU, and the Neural Engine.","For an LLM the GPU does the work, and since the M5 each of its cores has a matrix unit. The Neural Engine is a separate block for the features Apple ships itself."]'>
    <div class="fp-stage">
      <svg viewBox="0 0 320 176" role="img" aria-label="Apple Silicon: CPU, GPU and Neural Engine all share one unified memory pool">
        <g class="units f2">
          <line class="conn" x1="59" y1="58" x2="59" y2="116"></line>
          <line class="conn" x1="160" y1="58" x2="160" y2="116"></line>
          <line class="conn" x1="261" y1="58" x2="261" y2="116"></line>
          <g class="unit cpu"><rect x="18" y="18" width="82" height="40" rx="8"></rect><text x="59" y="43">CPU</text></g>
          <g class="unit gpu"><rect x="118" y="18" width="84" height="40" rx="8"></rect><text x="160" y="37">GPU</text><text class="sub" x="160" y="50">matrix units</text></g>
          <g class="unit ne"><rect x="220" y="18" width="82" height="40" rx="8"></rect><text x="261" y="37">Neural</text><text x="261" y="50">Engine</text></g>
        </g>
        <rect class="pool" x="18" y="116" width="284" height="38" rx="10"></rect>
        <text class="pl" x="160" y="140">unified memory · one shared pool</text>
      </svg>
    </div>
  </figure>
)}

{name === "radix-attention" && (
  <figure class="fp ill rdx" tabindex="0" data-dwell="3000" data-captions='["Request A: a long shared prefix, with its own ending computed and cached.","Request B begins the same way, so RadixAttention reuses the cached prefix and computes only the new ending for B.","And request C. The shared prefix lives once in a tree; every request that starts the same skips recomputing it."]'>
    <div class="fp-stage">
      <svg viewBox="0 0 320 178" role="img" aria-label="A radix tree: a shared prefix computed once, with each request branching off its own suffix">
        <text class="lab" x="90" y="62">shared prefix · computed once</text>
        <g class="trunk">
          <rect x="24" y="74" width="30" height="22" rx="4"></rect>
          <rect x="58" y="74" width="30" height="22" rx="4"></rect>
          <rect x="92" y="74" width="30" height="22" rx="4"></rect>
          <rect x="126" y="74" width="30" height="22" rx="4"></rect>
        </g>
        <text class="reuse f2" x="90" y="112">reused · cache hit</text>
        <g class="br">
          <path class="edge" d="M156,84 C 178,84 180,44 198,44"></path>
          <rect x="200" y="33" width="30" height="22" rx="4"></rect><rect x="234" y="33" width="30" height="22" rx="4"></rect>
          <text x="268" y="49">req A</text>
        </g>
        <g class="br f2">
          <path class="edge" d="M156,86 L198,86"></path>
          <rect x="200" y="75" width="30" height="22" rx="4"></rect><rect x="234" y="75" width="30" height="22" rx="4"></rect>
          <text x="268" y="91">req B</text>
        </g>
        <g class="br f3">
          <path class="edge" d="M156,88 C 178,88 180,128 198,128"></path>
          <rect x="200" y="117" width="30" height="22" rx="4"></rect><rect x="234" y="117" width="30" height="22" rx="4"></rect>
          <text x="268" y="133">req C</text>
        </g>
      </svg>
    </div>
  </figure>
)}

{name === "paged-attention" && (
  <figure class="fp ill pga" tabindex="0" data-dwell="3000" data-captions='["The naive way reserves one big contiguous slab per request, sized for its longest possible length, so most of it sits empty and only a few requests fit.","PagedAttention chops the cache into small fixed-size blocks handed out on demand, the way an operating system pages memory, so there is almost no waste and far more requests fit at once."]'>
    <div class="fp-stage">
      <svg viewBox="0 0 320 172" role="img" aria-label="Contiguous KV cache slabs waste memory, while PagedAttention packs small blocks on demand">
        <text class="cap" x="164" y="14">GPU memory · KV cache</text>
        <g class="o1">
          <g class="slab"><rect x="64" y="28" width="200" height="30" rx="5"></rect><rect class="used" x="64" y="28" width="56" height="30" rx="5"></rect><text class="rl" x="58" y="47">req A</text></g>
          <g class="slab"><rect x="64" y="66" width="200" height="30" rx="5"></rect><rect class="used" x="64" y="66" width="44" height="30" rx="5"></rect><text class="rl" x="58" y="85">req B</text></g>
          <g class="slab"><rect x="64" y="104" width="200" height="30" rx="5"></rect><rect class="used" x="64" y="104" width="70" height="30" rx="5"></rect><text class="rl" x="58" y="123">req C</text></g>
          <text class="rt" x="200" y="152">reserved, mostly empty</text>
        </g>
        <g class="o2">
          <rect class="blk" x="64" y="28" width="36" height="22" rx="4"></rect><rect class="blk2" x="105" y="28" width="36" height="22" rx="4"></rect><rect class="blk" x="146" y="28" width="36" height="22" rx="4"></rect><rect class="blk2" x="187" y="28" width="36" height="22" rx="4"></rect><rect class="blk" x="228" y="28" width="36" height="22" rx="4"></rect>
          <rect class="blk2" x="64" y="56" width="36" height="22" rx="4"></rect><rect class="blk" x="105" y="56" width="36" height="22" rx="4"></rect><rect class="blk2" x="146" y="56" width="36" height="22" rx="4"></rect><rect class="blk" x="187" y="56" width="36" height="22" rx="4"></rect><rect class="blk2" x="228" y="56" width="36" height="22" rx="4"></rect>
