<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Spreadsheet editor</title>
    <link id="cs-font-inter" rel="stylesheet" href="/pc/vendor/sheets/fonts.css" />
    <link id="cs-font-material-symbols" rel="stylesheet" href="/pc/vendor/sheets/fonts.css" />
    <style is:global>html,body,#casual-embed-root{margin:0;width:100%;height:100%;overflow:hidden}body{background:#fff;font-family:Inter,system-ui,sans-serif}[data-toolbar]{overflow-x:auto!important;flex-wrap:nowrap!important}#casual-embed-root{min-width:0}[data-testid="cs-panel-rail-pivot"],[data-testid="cs-panel-rail-charts"],[data-testid="cs-panel-rail-history"]{display:none!important}</style>
  </head>
  <body>
    <div id="casual-embed-root"></div>
    <script is:inline type="module">
      try {
        const { mountEmbedded } = await import('/pc/vendor/sheets/embed-runtime.js');
        mountEmbedded({ root: document.getElementById('casual-embed-root'), hostOrigin: location.origin });
      } catch (error) {
        document.getElementById('casual-embed-root').textContent = 'The spreadsheet could not load. Please retry.';
        parent.postMessage({type:'pc:sheets-error',message:String(error)},location.origin);
      }
    </script>
  </body>
</html>
