<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ws://127.0.0.1:* ws://localhost:*; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'"/><meta name="robots" content="noindex"/><title>Docs · WebPC</title><link rel="stylesheet" href="/pc/vendor/docs/styles.css"/></head>
<body><header><label>Docs <input id="name" aria-label="Document name" value="Untitled document" maxlength="100" data-edit disabled/></label><nav aria-label="Document actions"><button id="new" data-edit disabled>New</button><button id="open" data-edit disabled>Open…</button><button id="export" data-edit disabled>Export DOCX</button><button id="backup" data-edit disabled>Backup JSON</button><button id="recover" data-edit disabled>Recover previous</button><button id="print" data-edit disabled>Print / PDF</button><button id="help">Help</button></nav></header>
<div class="save-line"><span id="status" role="status">Opening editor…</span><span>This browser only</span><button id="retry">Retry save</button><button id="raw" hidden>Download stored data</button></div><p id="error" role="alert" hidden></p><main><div id="editor" class="ep-root"></div><div id="loading">Loading Docs…</div></main><input id="file" type="file" accept=".docx,.json" hidden/>
<dialog id="help-dialog" aria-labelledby="help-title"><h1 id="help-title">Write locally</h1><p>Write and format documents with headings, lists, links, and images. Edits save in this browser. New/Open keep one previous document for recovery. Export important work before clearing site data.</p><p>Open DOCX or this app’s JSON backups (up to 10 MB). DOCX compatibility is partial; check complex layouts in your destination app. JSON preserves the editor model. Print / PDF opens your browser’s print flow. This edition has no accounts, cloud sync, collaboration, or AI services. Large documents may exceed local storage. Fonts are limited to local substitutes; remote fonts and remote images are blocked. Narrow windows fit the page initially; use Zoom to enlarge it.</p><p>Powered by <a href="https://github.com/CasualOffice/docs" target="_blank" rel="noopener">Casual Docs 1.4.2</a> · <a href="/third-party/casual-docs/NOTICE" target="_blank">Notices</a></p><form method="dialog"><button>Close help</button></form></dialog>
<script is:inline type="module">import('/pc/vendor/docs/editor.js').catch(()=>{document.getElementById('error').hidden=false;document.getElementById('error').textContent='Docs could not load. Reload to retry; saved data has not been changed.';document.getElementById('loading').hidden=true;});</script>
</body></html>
<style is:global>
:where(.ep-root button){border:0;background:transparent;cursor:pointer}:where(.ep-root button,.ep-root input,.ep-root select,.ep-root textarea){font:inherit;color:inherit}.paged-editor__hidden-pm .ProseMirror{white-space:pre-wrap;overflow-wrap:break-word}:root{font-family:system-ui,sans-serif;color:#26312b;background:#eef2ef;color-scheme:light;--panel:#fff;--line:#d2ddd4;--muted:#53645a}html[data-theme=dark]{color:#e5eee8;background:#1c2720;color-scheme:dark;--panel:#24342a;--line:#43564a;--muted:#bdd0c3}*{box-sizing:border-box}html,body{margin:0;height:100%;overflow:hidden}body{display:flex;flex-direction:column;font-size:13px}header{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:8px 12px;background:var(--panel);border-bottom:1px solid var(--line)}header label{display:flex;align-items:center;gap:8px;font-weight:650}header input{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:4px;padding:6px;max-width:220px}nav{display:flex;flex-wrap:wrap;gap:5px}header button,.save-line button,dialog button{font:inherit;padding:5px 8px;background:var(--panel);color:inherit;border:1px solid var(--line);border-radius:4px;cursor:pointer}button:disabled{opacity:.55}button:focus-visible,input:focus-visible{outline:2px solid #2a9ec0;outline-offset:2px}.save-line{display:flex;gap:12px;align-items:center;flex-wrap:wrap;font-size:11px;padding:5px 12px;color:var(--muted)}#error{margin:0;padding:8px 12px;background:#fff0cc;color:#624207}main{position:relative;flex:1;min-height:0;overflow:hidden}#editor{height:100%;color:#202428;color-scheme:light;background:#f1f3f5}#loading{position:absolute;inset:0;display:grid;place-items:center;background:var(--panel)}#loading[hidden]{display:none}dialog{max-width:560px;max-height:85vh;overflow:auto;border:1px solid var(--line);border-radius:10px;padding:24px;line-height:1.6;background:var(--panel);color:inherit}dialog h1{font-size:20px}dialog::backdrop{background:#0008}a{color:#3185aa}@media(max-width:600px){header{padding:5px 8px}header input{max-width:190px}header button{font-size:11px;padding:4px 6px}.save-line{padding:4px 8px}#editor{overflow:auto}}
